# Copiar a .env para desarrollo local. En Netlify se definen por contexto
# (Site configuration → Environment variables). Sin valores aquí: solo nombres.

# --- Entorno (build). Netlify: production | staging (deploy-preview, branch-deploy).
# Todo lo que no sea production sale noindex y con robots.txt cerrado.
PUBLIC_SITE_ENV=development

# --- Analítica (build, se inlinean). Definir UNO de los dos: GTM tiene prioridad.
# Propiedad/contenedor distinto para staging y producción.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=

# --- Meta Pixel (build). Vacío = no se monta el pixel.
PUBLIC_META_PIXEL_ID=
# Ruta de la función CAPI; por defecto /.netlify/functions/meta-conversion
PUBLIC_META_CAPI_ENDPOINT=

# --- Meta Conversions API (runtime, scope Functions). Mismo pixel que PUBLIC_META_PIXEL_ID.
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Solo en staging. Nunca en production.
META_TEST_EVENT_CODE=
# Opcional: orígenes permitidos separados por coma. Vacío = mismo host.
ALLOWED_ORIGINS=

# --- Formulario de contacto (runtime, función contact-form)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# --- Validador SEO: SEO_STRICT=1 hace bloqueante `npm run seo:check`
SEO_STRICT=
