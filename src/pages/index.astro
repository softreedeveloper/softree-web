---
import Layout from '@layouts/Layout.astro';
import { generateServiceSchema } from '@/utils/seo.jsx';

import HeroSoftware from '@sections/HeroSoftware.astro';
import StatsBanner from '@sections/StatsBanner.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import AboutSoftware from '@sections/AboutSoftware.astro';
import SolutionsGrid from '@sections/SolutionsGrid.astro';
import PartnershipQuote from '@sections/PartnershipQuote.astro';
import CompanyStats from '@sections/CompanyStats.astro';
import Methodology from '@sections/Methodology.astro';
import Differentiators from '@sections/Differentiators.astro';
import FinalCTA from '@sections/FinalCTA.astro';

const serviceSchema = generateServiceSchema({
   name: 'Desarrollo de software a medida',
   description:
      'Softree desarrolla aplicaciones móviles, plataformas web, CRM/ERP, soluciones cloud y servicios de consultoría técnica para empresas que crecen.',
});
---

<Layout
   title="Softree | Software a medida — Apps, web, CRM y cloud"
   description="Transformamos ideas en software de alto rendimiento. Apps móviles, plataformas web, CRM/ERP, cloud e inteligencia artificial. Entregamos en semanas, no meses."
   type="website"
   schema={serviceSchema}
>
   <HeroSoftware />
   <StatsBanner />
   <FeatureColumns />
   <AboutSoftware />
   <SolutionsGrid />
   <PartnershipQuote />
   <CompanyStats />
   <Methodology />
   <Differentiators />
   <FinalCTA />
</Layout>
