---
import Layout from '@layouts/Layout.astro';
import { generateServiceSchema } from '@/utils/seo.js';

import HeroSoftware from '@sections/HeroSoftware.astro';
import StatsBanner from '@sections/StatsBanner.astro';
import AboutSoftware from '@sections/AboutSoftware.astro';
import ServicesGrid from '@sections/ServicesGrid.astro';

import Differentiators from '@sections/Differentiators.astro';
import TechMarquee from '@sections/TechMarquee.astro';
import ContactForm from '@sections/ContactForm.astro';

const serviceSchema = generateServiceSchema({
   slug: '/',
   name: 'Desarrollo de software a medida',
   description:
      'Softree desarrolla aplicaciones móviles, plataformas web, CRM/ERP, soluciones cloud y servicios de consultoría técnica para empresas que crecen.',
});

// Página estática: se genera en build, sin SSR por petición.
export const prerender = true;
---

<Layout type="website" schema={serviceSchema}>
   <HeroSoftware />

   <AboutSoftware />

   <ServicesGrid />

   <Differentiators />
   <TechMarquee />
   <ContactForm />
</Layout>
