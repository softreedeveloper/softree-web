---
import Layout from '@layouts/Layout.astro';
import ContactForm from '@sections/ContactForm.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';

// Página estática: se genera en build, sin SSR por petición.
export const prerender = true;
---

<!--
   Sin nodo Service: esta página es un formulario de contacto, no un servicio.
   El registro la declara como ContactPage y SEOHead la emite como tal.
-->
<Layout type="website">
   <div class="max-w-6xl mx-auto px-6 md:px-10 pt-28">
      <Breadcrumbs />
   </div>

   <ContactForm headingLevel="h1" />
</Layout>
