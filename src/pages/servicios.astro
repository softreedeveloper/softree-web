---
import Layout from '@layouts/Layout.astro';
import { generateServiceSchema } from '@/utils/seo.jsx';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import FinalCTA from '@sections/FinalCTA.astro';
import { services, servicesValueProps } from '@/data/services.js';

const serviceSchema = generateServiceSchema({
   name: 'Servicios de desarrollo de software',
   description:
      'Catálogo completo de servicios de Softree: aplicaciones a la medida, apps móviles, CRM/ERP, plataformas web, cloud, UI/UX y consultoría técnica.',
});
---

<Layout
   title="Softree | Servicios — Desarrollo de software, apps, CRM y cloud"
   description="Servicios de desarrollo a medida: aplicaciones móviles, plataformas web, CRM/ERP, cloud, UI/UX y consultoría técnica. Stack moderno y entrega en semanas."
   type="website"
   schema={serviceSchema}
>
   <!-- Hero -->
   <section class="relative py-20 md:py-28 bg-white dark:bg-zinc-950 overflow-hidden transition-colors duration-300">
      <div class="absolute inset-0 pointer-events-none opacity-[0.04] dark:opacity-[0.08] text-ink dark:text-white" aria-hidden="true">
         <svg width="100%" height="100%">
            <defs>
               <pattern id="grid-srv" width="40" height="40" patternUnits="userSpaceOnUse">
                  <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
               </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid-srv)" />
         </svg>
      </div>
      <div class="absolute top-20 -right-32 w-96 h-96 rounded-full bg-accent-200/30 dark:bg-accent-500/15 blur-3xl pointer-events-none"></div>

      <div class="relative max-w-5xl mx-auto px-6 md:px-10 text-center">
         <span class="inline-flex items-center gap-2 rounded-full border border-ink/10 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-1.5 text-xs font-medium text-ink-muted dark:text-white/60">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-500" />
            Servicios
         </span>
         <h1 class="mt-6 text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-ink dark:text-white leading-[1.05]">
            <span class="font-mono">{'{'}</span>
            Todo lo que necesitas
            <span class="font-mono">{'}'}</span>
            <span class="block mt-2 bg-gradient-to-r from-accent-500 to-accent-700 dark:from-accent-300 dark:to-accent-500 bg-clip-text text-transparent">
               para escalar
            </span>
         </h1>
         <p class="mt-6 text-base md:text-lg text-ink-muted dark:text-white/60 max-w-2xl mx-auto leading-relaxed">
            De la idea al deploy. Desarrollamos software a la medida con stack moderno, equipo senior y entregas semanales.
         </p>
         <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <Button href="/#contacto" variant="primary" size="lg">Cotizar proyecto</Button>
            <Button href="#listado" variant="secondary" size="lg" arrow={false}>Explorar servicios</Button>
         </div>
      </div>
   </section>

   <!-- Listado de servicios -->
   <section id="listado" class="py-20 md:py-28 bg-zinc-50/40 dark:bg-zinc-900/40 transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-6 md:px-10 space-y-16 md:space-y-20">
         {
            services.map((service, idx) => (
               <article class={`grid lg:grid-cols-2 gap-10 lg:gap-16 items-center ${idx % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
                  <!-- Info -->
                  <div class="reveal">
                     <div class="flex items-center gap-4 mb-5">
                        <span class="font-mono font-bold text-3xl md:text-4xl bg-gradient-to-br from-accent-500 to-accent-700 dark:from-accent-300 dark:to-accent-500 bg-clip-text text-transparent">
                           {service.number}
                        </span>
                        <span class="flex-1 h-px bg-ink/10 dark:bg-white/15" />
                     </div>
                     <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-ink dark:text-white tracking-tight leading-tight">
                        {service.title}
                     </h2>
                     <p class="mt-4 text-base text-ink-muted dark:text-white/60 leading-relaxed">{service.description}</p>
                     <div class="mt-6 flex flex-wrap gap-2">
                        {service.stack.map((s) => <Tag>{s}</Tag>)}
                     </div>
                     <div class="mt-8">
                        <Button href="/#contacto" variant="primary">Solicitar este servicio</Button>
                     </div>
                  </div>

                  <!-- Code snippet -->
                  <div class="reveal-scale delay-200">
                     <div class="relative">
                        <div class="absolute inset-0 -m-3 bg-gradient-to-tr from-accent-500/20 to-brand-200/20 dark:to-brand-500/20 blur-2xl rounded-3xl pointer-events-none"></div>
                        <div class="relative bg-ink rounded-2xl border border-white/5 shadow-2xl shadow-ink/30 overflow-hidden">
                           <div class="flex items-center justify-between px-4 py-3 border-b border-white/5 bg-zinc-900/50">
                              <div class="flex items-center gap-1.5">
                                 <span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
                                 <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/80"></span>
                                 <span class="w-2.5 h-2.5 rounded-full bg-green-400/80"></span>
                              </div>
                              <span class="text-[10px] font-mono text-white/40">{service.title.toLowerCase().replace(/[^a-z0-9]/g, '-')}.config.ts</span>
                              <span class="text-[10px] font-mono text-white/30">{service.number}</span>
                           </div>
                           <pre class="code-block p-5 text-white/90 overflow-x-auto"><code>{service.snippet.map((row) => (
                              <div>
                                 {row.type === 'com' ? (
                                    <span class="tk-com">{row.text}</span>
                                 ) : (
                                    <>
                                       {row.parts?.map((p: any) => {
                                          if (p.k) return <span class="tk-key">{p.k}</span>;
                                          if (p.s) return <span class="tk-com">{p.s} </span>;
                                          if (p.v) return <span class="tk-str">{p.v}</span>;
                                          return null;
                                       })}
                                    </>
                                 )}
                              </div>
                           ))}</code></pre>
                        </div>
                     </div>
                  </div>
               </article>
            ))
         }
      </div>
   </section>

   <!-- Value props -->
   <section class="py-20 md:py-28 bg-white dark:bg-zinc-950 transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-6 md:px-10">
         <SectionHeading
            eyebrow="Garantías"
            title="Lo que siempre incluye trabajar con Softree"
            align="center"
            class="mb-12"
         />
         <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {
               servicesValueProps.map((prop, i) => (
                  <div class={`rounded-2xl border border-ink/10 dark:border-white/10 bg-white dark:bg-zinc-900 p-6 hover:border-accent-500/40 hover:shadow-lg transition-all duration-300 reveal delay-${(i + 1) * 100}`}>
                     <div class="w-10 h-10 rounded-full bg-accent-50 dark:bg-accent-500/15 flex items-center justify-center mb-4">
                        <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                     </div>
                     <p class="text-sm font-medium text-ink dark:text-white/85 leading-relaxed">{prop}</p>
                  </div>
               ))
            }
         </div>
      </div>
   </section>

   <FinalCTA />
</Layout>
