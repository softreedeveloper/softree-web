---
import Layout from '@layouts/Layout.astro';
import Button from '@components/ui/Button.astro';

// Página estática: se genera en build, sin SSR por petición.
export const prerender = true;
---

<Layout>
   <section class="flex flex-col items-center justify-center min-h-[70vh] px-6 text-center">
      <span class="font-mono text-sm tracking-[0.2em] uppercase text-accent-600 dark:text-accent-400">Error 404</span>

      <h1 class="mt-4 text-5xl md:text-6xl font-bold tracking-tight text-ink dark:text-white">Esta ruta no existe</h1>

      <p class="mt-5 max-w-md text-base text-ink-muted dark:text-white/60 leading-relaxed">
         El enlace que seguiste no lleva a ninguna parte. Puede que la página se haya movido o que la dirección tenga
         una errata.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
         <Button
            href="/"
            variant="primary"
            size="lg"
            data-cta="404_inicio"
            data-page-type="404"
            data-section-name="contenido"
            data-destination-type="internal_page"
         >
            Volver al inicio
         </Button>
         <Button
            href="/#servicios"
            variant="secondary"
            size="lg"
            arrow={false}
            data-cta="404_servicios"
            data-page-type="404"
            data-section-name="contenido"
            data-destination-type="anchor"
         >
            Ver servicios
         </Button>
      </div>
   </section>
</Layout>
