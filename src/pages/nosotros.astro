---
import Layout from '@layouts/Layout.astro';
import { siteConfigData } from '@/utils/site-config.jsx';
import { generateServiceSchema } from '@/utils/seo.jsx';

const serviceSchema = generateServiceSchema({
   name: 'Quiénes somos – Softree',
   description: 'Empresa de limpieza profesional en CDMX con misión de satisfacción total, visión sustentable y equipo constantemente capacitado.',
});

const pillars = [
   {
      icon: '🎯',
      title: 'Misión',
      text: 'Brindar la satisfacción del cliente, haciendo realidad las expectativas en cualquier trabajo que apliquemos.',
      accent: 'brand',
   },
   {
      icon: '🔭',
      title: 'Visión',
      text: 'Posicionarnos entre las mejores empresas proveedoras en servicios de limpieza y mantenimiento apoyando el medio ambiente.',
      accent: 'brand',
   },
   {
      icon: '🎓',
      title: 'Capacitación',
      text: 'Brindamos capacitación constante, actualizando con temas a la vanguardia, para dar el mejor servicio.',
      accent: 'sky',
   },
   {
      icon: '🌿',
      title: 'Productos',
      text: 'Proporcionamos y aplicamos productos de calidad en apoyo al medioambiente.',
      accent: 'sky',
   },
   {
      icon: '📋',
      title: 'Bitácora y reportes',
      text: 'Damos un seguimiento administrativo para un mayor control.',
      accent: 'indigo',
   },
   {
      icon: '✅',
      title: 'Servicios',
      text: 'Los servicios se adaptan a las necesidades del cliente.',
      accent: 'indigo',
   },
];
---

<Layout
   title="Nosotros | Softree"
   description="Conoce la misión, visión y pilares de Softree: empresa de limpieza profesional en CDMX comprometida con la calidad, el medioambiente y la satisfacción del cliente."
   type="website"
   schema={serviceSchema}
>

   <!-- ─── HERO NOSOTROS ──────────────────────────────────────────────────── -->
   <section class="relative bg-white py-20 px-4 md:px-12 overflow-hidden">
      <!-- Fondo decorativo -->
      <div class="absolute inset-0 pointer-events-none">
         <div class="absolute top-0 right-0 w-2/5 h-full bg-brand-50 rounded-bl-[80px] hidden lg:block"></div>
         <div class="absolute top-24 right-10 w-5 h-5 bg-brand-300 rounded-full opacity-50"></div>
         <div class="absolute bottom-16 left-16 w-3 h-3 bg-brand-400 rounded-full opacity-40"></div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
         <!-- Texto -->
         <div data-aos="fade-right" data-aos-duration="900">
            <span class="inline-block bg-brand-100 text-brand-800 text-xs font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full mb-5">
               Quiénes somos
            </span>
            <h1 class="text-4xl md:text-5xl font-extrabold text-dark leading-tight mb-5">
               Limpieza profesional –<br />
               <em class="not-italic text-brand-600">con propósito real.</em>
            </h1>
            <p class="text-gray-600 text-lg leading-relaxed mb-8 max-w-lg">
               Somos Softree, una empresa mexicana especializada en servicios de limpieza y mantenimiento. Trabajamos con compromiso, calidad y respeto al medio ambiente en cada proyecto.
            </p>
            <a
               href="#pilares"
               class="inline-flex items-center gap-2 bg-brand-700 hover:bg-brand-800 text-white font-semibold px-7 py-3.5 rounded-full transition-all duration-300 shadow-lg hover:shadow-brand-700/40 hover:-translate-y-0.5"
            >
               Conoce nuestros pilares &darr;
            </a>
         </div>

         <!-- Imagen -->
         <div class="relative" data-aos="fade-left" data-aos-duration="900" data-aos-delay="100">
            <div class="rounded-3xl overflow-hidden shadow-2xl aspect-[4/3]">
               <img
                  src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=85"
                  alt="Equipo Softree trabajando"
                  class="w-full h-full object-cover"
                  loading="eager"
               />
               <div class="absolute inset-0 bg-gradient-to-t from-brand-950/20 to-transparent"></div>
            </div>
            <!-- Badge años -->
            <div class="absolute -bottom-5 -left-5 bg-brand-700 text-white rounded-2xl shadow-xl px-6 py-4 hidden md:block" data-aos="fade-up" data-aos-delay="400">
               <p class="text-3xl font-extrabold" data-count="10" data-suffix="+">10+</p>
               <p class="text-brand-200 text-xs mt-0.5">Años de experiencia</p>
            </div>
         </div>
      </div>
   </section>

   <!-- ─── STATS ─────────────────────────────────────────────────────────── -->
   <section class="bg-brand-900 py-10 px-4">
      <div class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
         {[
            { value: '500+', label: 'Clientes atendidos' },
            { value: '10+',  label: 'Años de experiencia' },
       
            { value: '24h',  label: 'Respuesta garantizada' },
         ].map((s, i) => (
            <div data-aos="fade-up" data-aos-delay={i * 80}>
               <p class="text-3xl font-extrabold text-white">{s.value}</p>
               <p class="text-brand-300 text-xs mt-1 uppercase tracking-wider">{s.label}</p>
            </div>
         ))}
      </div>
   </section>

   <!-- ─── PILARES ───────────────────────────────────────────────────────── -->
   <section id="pilares" class="bg-white py-24 px-4 md:px-12">
      <div class="max-w-6xl mx-auto">
         <div class="text-center mb-14" data-aos="fade-up">
            <span class="text-brand-600 text-sm font-semibold tracking-widest uppercase">Lo que nos define</span>
            <h2 class="mt-3 text-3xl md:text-4xl font-extrabold text-dark leading-tight">
               Nuestros pilares
            </h2>
            <p class="mt-3 text-gray-500 max-w-lg mx-auto">
               Cada aspecto de nuestro trabajo está guiado por valores concretos que garantizan resultados excepcionales.
            </p>
         </div>

         <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {pillars.map((p, i) => (
               <div
                  class="group bg-white border border-gray-100 rounded-3xl p-8 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-default"
                  data-aos="fade-up"
                  data-aos-delay={i * 80}
               >
                  <!-- Icono -->
                  <div class="w-14 h-14 bg-brand-50 rounded-2xl flex items-center justify-center text-3xl mb-5 group-hover:bg-brand-100 transition-colors duration-300">
                     {p.icon}
                  </div>
                  <!-- Contenido -->
                  <h3 class="text-xl font-extrabold text-dark mb-3">{p.title}</h3>
                  <p class="text-gray-500 leading-relaxed text-sm">{p.text}</p>
                  <!-- Línea decorativa -->
                  <div class="mt-6 h-1 w-12 bg-brand-400 rounded-full group-hover:w-20 transition-all duration-500"></div>
               </div>
            ))}
         </div>
      </div>
   </section>

   <!-- ─── CTA ───────────────────────────────────────────────────────────── -->
   <section class="bg-brand-50 py-20 px-4">
      <div class="max-w-3xl mx-auto text-center" data-aos="fade-up">
         <h2 class="text-3xl md:text-4xl font-extrabold text-dark mb-4">
            ¿Listo para trabajar <em class="not-italic text-brand-600">con nosotros</em>?
         </h2>
         <p class="text-gray-500 mb-8">Cotiza sin costo y sin compromisos. Nuestro equipo responde en menos de 24 horas.</p>
         <a
            href={`https://wa.me/${siteConfigData.contacto.WHATSAPP.replace(/\D/g, '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-brand-700 hover:bg-brand-800 text-white font-bold px-8 py-4 rounded-full transition-all duration-300 shadow-lg hover:shadow-brand-700/30"
         >
            💬 Escríbenos por WhatsApp
         </a>
      </div>
   </section>

</Layout>
