---
/**
 * Agentes de IA en la home: casos de uso reales + el ciclo percibe → razona →
 * actúa → supervisado que los distingue de un chatbot. Datos en data/ai-agents.js.
 */
import Button from '@components/ui/Button.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { aiAgents, agentLoop, agentLog } from '@/data/ai-agents.js';

const iconPaths = {
   chat: 'M8 10h8M8 14h5M21 12a8 8 0 01-11.6 7.1L4 21l1.9-5.4A8 8 0 1121 12z',
   book: 'M4 5a2 2 0 012-2h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm4 0v16M12 8h4M12 12h4',
   file: 'M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-5zm0 0v5h5M9 13h6M9 17h6',
   chart: 'M4 20h16M7 16V9M12 16V5M17 16v-4',
};

const logStyles = {
   in: { mark: '→', cls: 'text-zinc-400' },
   think: { mark: '…', cls: 'text-amber-200' },
   act: { mark: '⚡', cls: 'text-accent-300' },
   ok: { mark: '✓', cls: 'text-accent-400' },
};
---

<section id="agentes-ia" class="py-20 md:py-28 bg-white dark:bg-zinc-950 transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10">
      <SectionHeading
         eyebrow="Agentes de IA"
         title="Agentes de IA que trabajan dentro de tu operación"
         subtitle="No son chatbots de opciones fijas: entienden lenguaje natural, consultan tus datos y ejecutan acciones en tus sistemas. Los desplegamos con GPT, Claude, Gemini o modelos abiertos, con límites claros y supervisión humana."
         class="mb-12 md:mb-16"
      />

      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-8 lg:gap-12 items-start">
         <!-- Casos de uso -->
         <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
            {
               aiAgents.map((agent, i) => (
                  <article
                     class={`group relative rounded-3xl border border-ink/5 dark:border-white/[0.07] bg-zinc-50/60 dark:bg-zinc-900/50 p-6 md:p-7 overflow-hidden hover:border-accent-500/30 hover:-translate-y-1 hover:shadow-2xl hover:shadow-accent-500/5 transition-all duration-500 reveal delay-${(i + 1) * 100}`}
                  >
                     <div class="absolute -bottom-12 -right-12 w-40 h-40 rounded-full bg-accent-500/5 dark:bg-accent-500/10 blur-3xl pointer-events-none group-hover:bg-accent-500/15 transition-all duration-700" />
                     <div class="relative">
                        <div class="w-11 h-11 rounded-xl bg-accent-50 dark:bg-accent-500/15 flex items-center justify-center text-accent-600 dark:text-accent-400">
                           <svg
                              class="w-5 h-5"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                           >
                              <path d={iconPaths[agent.icon]} />
                           </svg>
                        </div>
                        <h3 class="mt-5 text-lg md:text-xl font-bold text-ink dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-300 transition-colors">
                           {agent.title}
                        </h3>
                        <p class="mt-1 font-mono text-[11px] uppercase tracking-wide text-ink-muted dark:text-white/45">
                           {agent.channel}
                        </p>
                        <p class="mt-3 text-sm text-ink-muted dark:text-white/60 leading-relaxed">
                           {agent.description}
                        </p>
                        <ul class="mt-4 space-y-1.5">
                           {agent.outcomes.map((o) => (
                              <li class="flex items-start gap-2 text-sm text-ink dark:text-white/85">
                                 <span class="mt-[7px] h-1.5 w-1.5 rounded-full bg-accent-500 flex-shrink-0" />
                                 {o}
                              </li>
                           ))}
                        </ul>
                     </div>
                  </article>
               ))
            }
         </div>

         <!-- Cómo trabaja un agente -->
         <div class="lg:sticky lg:top-24 reveal-right delay-200">
            <div class="rounded-3xl bg-ink dark:bg-zinc-900 border border-white/10 p-6 md:p-8 text-white">
               <p class="font-mono text-[11px] uppercase tracking-widest text-accent-400">Cómo trabaja un agente</p>

               <ol class="mt-6 space-y-5">
                  {
                     agentLoop.map((item, i) => (
                        <li class="flex gap-4">
                           <span class="flex-shrink-0 w-8 h-8 rounded-full border border-accent-500/40 bg-accent-500/15 font-mono text-xs font-bold text-accent-300 flex items-center justify-center">
                              {String(i + 1).padStart(2, '0')}
                           </span>
                           <div>
                              <p class="font-semibold">{item.step}</p>
                              <p class="mt-0.5 text-sm text-white/55 leading-relaxed">{item.description}</p>
                           </div>
                        </li>
                     ))
                  }
               </ol>

               <div class="mt-7 rounded-xl bg-black/40 border border-white/10 p-4 font-mono text-xs leading-relaxed">
                  <div class="flex items-center gap-1.5 mb-3">
                     <span class="w-2 h-2 rounded-full bg-red-400"></span>
                     <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
                     <span class="w-2 h-2 rounded-full bg-green-400"></span>
                     <span class="ml-2 text-zinc-500 text-[10px]">agente-ventas.log</span>
                  </div>
                  <ul class="space-y-1.5">
                     {
                        agentLog.map((row) => (
                           <li class={`flex gap-2 ${logStyles[row.type].cls}`}>
                              <span class="flex-shrink-0 w-4 text-center">{logStyles[row.type].mark}</span>
                              <span>{row.text}</span>
                           </li>
                        ))
                     }
                  </ul>
               </div>

               <div class="mt-7 flex flex-col sm:flex-row gap-3">
                  <Button
                     href="/#contacto"
                     variant="accent"
                     data-cta="home_agentes_cotizar"
                     data-page-type="home"
                     data-section-name="agentes-ia"
                     data-placement="contenido"
                     data-destination-type="anchor"
                  >
                     Cotizar un agente
                  </Button>
                  <Button href="/inteligencia-artificial" variant="ghost" class="text-white">
                     Ver el servicio de IA
                  </Button>
               </div>
            </div>
         </div>
      </div>
   </div>
</section>
