---
const reasons = [
   'Personal capacitado y con verificación de antecedentes.',
   'Productos de limpieza ecológicos y biodegradables.',
   'Puntualidad garantizada en cada visita.',
   'Presupuesto sin costo y sin compromisos.',
   'Seguimiento post-servicio para tu tranquilidad.',
];
---

<section class="relative bg-white py-24 px-4 md:px-12 overflow-hidden">
   <!-- Efectos de difuminación -->
   <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 -right-40 w-96 h-96 bg-brand-400 rounded-full blur-3xl opacity-10"></div>
      <div class="absolute bottom-1/4 -left-40 w-80 h-80 bg-brand-500 rounded-full blur-3xl opacity-10"></div>
   </div>
   <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Imagen -->
      <div class="relative" data-aos="fade-right" data-aos-duration="800">
         <div class="rounded-3xl overflow-hidden shadow-2xl shadow-brand-900/15 aspect-[4/3]">
            <img
               src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=85"
               alt="Equipo Softree trabajando"
               class="w-full h-full object-cover"
               loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-800/20 via-transparent to-transparent"></div>
         </div>
         <div class="absolute -bottom-6 -right-6 bg-brand-600 text-white rounded-2xl p-5 shadow-xl hidden md:block">
            <p class="text-xs text-brand-200 uppercase tracking-wider">Nuestro método</p>
            <p class="font-bold mt-1">Auditoría &bull; Limpieza &bull; Verificación</p>
         </div>
      </div>

      <!-- Lista -->
      <div data-aos="fade-left" data-aos-duration="800">
         <span class="text-brand-500 text-sm font-semibold tracking-widest uppercase">Por qué elegirnos</span>
         <h2 class="mt-3 text-3xl md:text-4xl font-extrabold text-dark leading-tight mb-8">
            Transforma tu espacio con el<br />
            <em class="not-italic text-brand-500">toque Softree.</em>
         </h2>

         <div class="space-y-4">
            {
               reasons.map((r, i) => (
                  <div class="flex items-start gap-4" data-aos="fade-up" data-aos-delay={i * 80}>
                     <div class="w-7 h-7 rounded-full bg-brand-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg
                           class="w-4 h-4 text-brand-600"
                           fill="none"
                           viewBox="0 0 24 24"
                           stroke="currentColor"
                           stroke-width="2.5"
                        >
                           <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                     </div>
                     <p class="text-gray-700 leading-relaxed">{r}</p>
                  </div>
               ))
            }
         </div>

         <div class="mt-10 grid grid-cols-2 gap-4">
            <div class="bg-brand-50 rounded-2xl p-4 text-center border border-brand-100">
               <p class="text-2xl font-extrabold text-brand-700">500+</p>
               <p class="text-gray-500 text-sm mt-1">Reseñas positivas</p>
            </div>
            <div class="bg-brand-50 rounded-2xl p-4 text-center border border-brand-100">
               <p class="text-2xl font-extrabold text-brand-700">200+</p>
               <p class="text-gray-500 text-sm mt-1">Empresas atendidas</p>
            </div>
         </div>
      </div>
   </div>
</section>
