---
const stats = [
   { count: 500, suffix: '+', label: 'Tazas de café', icon: 'coffee' },
   { count: 250, suffix: '+', label: 'Horas de código/mes', icon: 'code' },
   { count: 10, suffix: 'k+', label: 'Líneas al mes', icon: 'terminal' },
];
---

<section class="border-y border-ink/5 dark:border-white/5 bg-zinc-50/50 dark:bg-zinc-900/40 transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10 py-8 md:py-10">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
         {
            stats.map((stat, i) => (
               <div class={`flex items-center justify-center gap-4 px-5 py-4 rounded-2xl bg-white dark:bg-zinc-900 border border-ink/5 dark:border-white/5 hover:border-accent-500/30 hover:shadow-sm transition-all reveal delay-${(i + 1) * 100}`}>
                  <div class="w-10 h-10 rounded-full bg-accent-50 dark:bg-accent-500/15 flex items-center justify-center flex-shrink-0">
                     {stat.icon === 'coffee' && (
                        <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h12a2 2 0 012 2v3a4 4 0 01-4 4H7a4 4 0 01-4-4v-5zM15 10v0a3 3 0 013 3v0a3 3 0 01-3 3M7 7V4m4 3V4" />
                        </svg>
                     )}
                     {stat.icon === 'code' && (
                        <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                     )}
                     {stat.icon === 'terminal' && (
                        <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                     )}
                  </div>
                  <div>
                     <p class="text-2xl md:text-3xl font-bold font-mono text-ink dark:text-white leading-none">
                        <span data-count={stat.count} data-suffix={stat.suffix}>0{stat.suffix}</span>
                     </p>
                     <p class="text-xs text-ink-muted dark:text-white/55 mt-1">{stat.label}</p>
                  </div>
               </div>
            ))
         }
      </div>
   </div>
</section>
