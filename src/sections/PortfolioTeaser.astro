---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import Tag from '@components/ui/Tag.astro';
import { portfolio } from '@/data/company-stats.js';
---

<section id="portafolio" class="py-20 md:py-28 bg-zinc-50/40 dark:bg-zinc-900/40 transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
         <SectionHeading
            eyebrow="Portafolio"
            title="Proyectos que hablan por sí solos"
            subtitle="Cada proyecto es una historia de transformación digital."
            class="md:max-w-2xl"
         />
         <div class="hidden md:block reveal delay-200">
            <Button href="/contacto" variant="secondary">Ver todo</Button>
         </div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
         {
            portfolio.map((item, i) => (
               <a
                  href="/contacto"
                  class={`group relative rounded-2xl overflow-hidden bg-white dark:bg-zinc-900 border border-ink/10 dark:border-white/10 hover:border-accent-500/40 hover:shadow-xl transition-all duration-500 reveal delay-${Math.min((i + 1) * 100, 500)}`}
               >
                  <div class="aspect-[4/3] overflow-hidden bg-zinc-100 dark:bg-zinc-800">
                     <img
                        src={item.image}
                        alt={item.title}
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 dark:opacity-90"
                     />
                  </div>
                  <div class="p-5">
                     <Tag variant="accent">{item.tag}</Tag>
                     <h3 class="mt-3 text-lg font-bold text-ink dark:text-white leading-tight">{item.title}</h3>
                     <p class="mt-2 text-sm text-ink-muted dark:text-white/60 leading-relaxed line-clamp-2">{item.description}</p>
                  </div>
                  <div class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/90 dark:bg-zinc-900/90 backdrop-blur flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:-translate-y-1 transition-all duration-300">
                     <svg class="w-4 h-4 text-ink dark:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 17l9.2-9.2M17 17V7H7" />
                     </svg>
                  </div>
               </a>
            ))
         }
      </div>

      <div class="md:hidden mt-8 reveal">
         <Button href="/contacto" variant="secondary" class="w-full justify-center">Ver todo</Button>
      </div>
   </div>
</section>
