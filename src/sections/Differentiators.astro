---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { differentiators } from '@/data/company-stats.js';
---

<section class="py-20 md:py-28 bg-zinc-50/40 dark:bg-zinc-900/40 transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10">
      <SectionHeading
         eyebrow="Nuestra ventaja"
         title="Lo que nos diferencia"
         subtitle="Hechos, no promesas. Estas son las razones por las que nuestros clientes nos eligen."
         align="center"
         class="mb-14"
      />

      <div class="grid md:grid-cols-3 gap-5 md:gap-6">
         {
            differentiators.map((d, i) => (
               <div class={`relative rounded-3xl bg-white dark:bg-zinc-900 border border-ink/10 dark:border-white/10 p-8 md:p-10 overflow-hidden hover:border-accent-500/40 hover:shadow-xl transition-all duration-500 reveal delay-${(i + 1) * 100}`}>
                  <!-- Decorative blob -->
                  <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-accent-500/5 dark:bg-accent-500/15 blur-2xl pointer-events-none" />
                  <p class="font-mono text-5xl md:text-6xl font-bold bg-gradient-to-br from-accent-500 to-accent-700 dark:from-accent-300 dark:to-accent-500 bg-clip-text text-transparent leading-none">
                     {d.number}
                  </p>
                  <h3 class="mt-5 text-xl md:text-2xl font-bold text-ink dark:text-white">{d.title}</h3>
                  <p class="mt-3 text-sm md:text-base text-ink-muted dark:text-white/60 leading-relaxed">{d.description}</p>
               </div>
            ))
         }
      </div>
   </div>
</section>
