---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Tag from '@components/ui/Tag.astro';
import { solutions } from '@/data/solutions.js';

const iconPaths = {
   smartphone: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
   monitor: 'M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25',
   database: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4',
   cloud: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
   palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
   briefcase: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
};
---

<section id="soluciones" class="py-20 md:py-28 bg-white dark:bg-zinc-950 transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10">
      <SectionHeading
         eyebrow="Soluciones"
         title="Soluciones robustas para empresas que crecen"
         subtitle="Tecnología empresarial que resuelve problemas reales."
      />

      <div class="mt-12 md:mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
         {
            solutions.map((s, i) => (
               <div class={`group relative rounded-2xl border border-ink/10 dark:border-white/10 bg-white dark:bg-zinc-900 p-6 md:p-7 hover:border-accent-500/40 dark:hover:border-accent-500/40 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 reveal delay-${Math.min((i + 1) * 100, 500)}`}>
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-50 to-accent-100 dark:from-accent-500/15 dark:to-accent-500/25 flex items-center justify-center mb-5 group-hover:from-accent-500 group-hover:to-accent-600 transition-all">
                     <svg class="w-6 h-6 text-accent-600 dark:text-accent-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[s.icon]} />
                     </svg>
                  </div>
                  <h3 class="text-lg md:text-xl font-bold text-ink dark:text-white mb-2 leading-tight">{s.title}</h3>
                  <p class="text-sm text-ink-muted dark:text-white/60 leading-relaxed mb-5">{s.description}</p>
                  <div class="flex flex-wrap gap-2">
                     {s.tags.map((t) => <Tag>{t}</Tag>)}
                  </div>
               </div>
            ))
         }
      </div>
   </div>
</section>
