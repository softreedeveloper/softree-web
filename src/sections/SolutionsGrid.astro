---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { solutions } from '@/data/solutions.js';

const iconPaths = {
   code: { d: null, poly: true },
   smartphone: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
   settings: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
   monitor: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
   cloud: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
   palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
   bot: 'M12 2a2 2 0 012 2v1h4a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h4V4a2 2 0 012-2zm-4 8a1 1 0 100 2 1 1 0 000-2zm8 0a1 1 0 100 2 1 1 0 000-2zm-4 4a3 3 0 01-2.83-2h5.66A3 3 0 0112 14z',
   book: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
};

// Todos los colores de tarjeta derivan de la escala accent (verde Softree)
const colorMap = {
   accent:  { css: '#27a317' },
   green:   { css: '#5bbf48' },
   purple:  { css: '#1a6911' },
   blue:    { css: '#1f8512' },
   cyan:    { css: '#8ed87f' },
   pink:    { css: '#185313' },
   orange:  { css: '#bdeab4' },
};

const widthClass = {
   w12: 'lg:col-span-12',
   w8:  'lg:col-span-8',
   w6:  'lg:col-span-6',
   w4:  'lg:col-span-4',
};
---

<section id="soluciones" class="py-20 md:py-28 bg-white dark:bg-zinc-950 transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10">
      <SectionHeading
         eyebrow="Soluciones"
         title="Lo que hacemos, lo hacemos diferente"
         subtitle="Soluciones de software que resuelven problemas reales. Haz clic en cualquier servicio para ver cómo lo ejecutamos."
      />

      <!-- Bento Grid -->
      <div class="mt-12 md:mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 md:gap-4">
         {
            solutions.map((s, i) => {
               const color = colorMap[s.color] ?? colorMap.accent;
               return (
                  <button
                     type="button"
                     class={`svc-card group relative text-left rounded-2xl border border-ink/10 dark:border-white/10 bg-white dark:bg-zinc-900 p-6 md:p-7 cursor-pointer transition-all duration-300 overflow-hidden sm:col-span-1 ${widthClass[s.width]} reveal delay-${Math.min((i + 1) * 100, 500)}`}
                     data-idx={i}
                     style={`--card-color:${color.css}`}
                  >
                     {/* Top accent line */}
                     <span class="svc-topline absolute top-0 left-0 right-0 h-0.5 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" style={`background:${color.css}`} />

                     {/* Number */}
                     <span class="absolute top-4 right-5 font-mono text-xs font-semibold tracking-wide opacity-30 group-hover:opacity-70 transition-opacity duration-300" style={`color:${color.css}`}>
                        {s.number}
                     </span>

                     {/* Icon */}
                     <div
                        class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 transition-all duration-300"
                        style={`background:color-mix(in srgb,${color.css} 12%,transparent);border:1px solid color-mix(in srgb,${color.css} 18%,transparent)`}
                     >
                        {s.icon === 'code' ? (
                           <svg class="w-5 h-5 transition-all duration-300" style={`color:${color.css}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="16 18 22 12 16 6" />
                              <polyline points="8 6 2 12 8 18" />
                              <line x1="14" y1="4" x2="10" y2="20" />
                           </svg>
                        ) : s.icon === 'settings' ? (
                           <svg class="w-5 h-5 transition-all duration-300" style={`color:${color.css}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="3" />
                              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                           </svg>
                        ) : s.icon === 'bot' ? (
                           <svg class="w-5 h-5 transition-all duration-300" style={`color:${color.css}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="3" y="11" width="18" height="11" rx="2" />
                              <path d="M12 2v4M8 11V9a4 4 0 018 0v2" />
                              <circle cx="9" cy="16" r="1" fill="currentColor" />
                              <circle cx="15" cy="16" r="1" fill="currentColor" />
                              <path d="M9.5 19.5a3 3 0 005 0" />
                           </svg>
                        ) : (
                           <svg class="w-5 h-5 transition-all duration-300" style={`color:${color.css}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d={iconPaths[s.icon]} />
                           </svg>
                        )}
                     </div>

                     <h3 class="font-bold text-base md:text-lg text-ink dark:text-white mb-2 leading-tight transition-colors duration-300 group-hover:text-[var(--card-color)]">
                        {s.title}
                     </h3>
                     <p class="text-sm text-ink/60 dark:text-white/55 leading-relaxed mb-4">{s.description}</p>

                     <div class="flex flex-wrap gap-1.5">
                        {
                           s.tags.map((t) => (
                              <span class="inline-block text-[0.6rem] font-mono px-2 py-1 rounded-md border border-ink/10 dark:border-white/10 text-ink/50 dark:text-white/40 bg-zinc-50 dark:bg-zinc-800 transition-all duration-300 group-hover:border-[color-mix(in_srgb,var(--card-color)_35%,transparent)] group-hover:text-[var(--card-color)] group-hover:bg-[color-mix(in_srgb,var(--card-color)_6%,transparent)]">
                                 {t}
                              </span>
                           ))
                        }
                     </div>

                     {/* Arrow */}
                     <span class="absolute bottom-4 right-5 w-7 h-7 rounded-full border border-ink/10 dark:border-white/10 flex items-center justify-center opacity-40 group-hover:opacity-100 transition-all duration-300" style={`group-hover:border-color:${color.css}`}>
                        <svg class="w-3 h-3 text-ink/40 dark:text-white/40 group-hover:translate-x-0.5 transition-transform" style={`color:${color.css};opacity:0`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                           <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                     </span>
                  </button>
               );
            })
         }
      </div>
   </div>
</section>

<!-- Modal overlay -->
<div id="svc-overlay" class="fixed inset-0 z-[1000] flex items-end md:items-center justify-center p-0 md:p-8 opacity-0 pointer-events-none transition-opacity duration-300" role="dialog" aria-modal="true" aria-labelledby="svc-modal-title">
   <div id="svc-overlay-bg" class="absolute inset-0 bg-zinc-950/80 backdrop-blur-md" />
   <div
      id="svc-modal"
      class="relative w-full md:max-w-2xl bg-white dark:bg-zinc-900 rounded-t-3xl md:rounded-3xl border border-ink/10 dark:border-white/10 max-h-[92vh] overflow-y-auto shadow-2xl translate-y-8 md:translate-y-0 md:scale-95 opacity-0 transition-all duration-500"
      style="scrollbar-width:thin"
   >
      <!-- Modal head (sticky) -->
      <div id="svc-modal-head" class="sticky top-0 z-10 flex items-start gap-4 px-6 md:px-10 py-6 md:py-8 border-b border-ink/10 dark:border-white/10 bg-white dark:bg-zinc-900 rounded-t-3xl md:rounded-t-3xl">
         <div id="svc-modal-icon" class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0">
            <!-- icon injected by JS -->
         </div>
         <div class="flex-1 min-w-0">
            <div id="svc-modal-tag" class="text-[0.58rem] font-mono font-semibold tracking-[0.08em] uppercase mb-1.5" />
            <div id="svc-modal-title" class="text-xl md:text-2xl font-extrabold text-ink dark:text-white leading-tight" />
            <div id="svc-modal-subtitle" class="hidden md:block mt-1.5 text-sm text-ink/60 dark:text-white/55 leading-relaxed" />
         </div>
         <button id="svc-modal-close" type="button" aria-label="Cerrar" class="shrink-0 w-10 h-10 rounded-full border border-ink/10 dark:border-white/10 flex items-center justify-center text-ink/40 dark:text-white/40 hover:text-ink dark:hover:text-white hover:border-ink/20 dark:hover:border-white/20 transition-all">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-4 h-4">
               <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
         </button>
      </div>

      <!-- Modal body -->
      <div class="px-6 md:px-10 py-6 md:py-8">
         <!-- Mobile subtitle -->
         <div id="svc-modal-subtitle-mobile" class="md:hidden text-sm text-ink/60 dark:text-white/55 leading-relaxed mb-6" />

         <!-- Features -->
         <div id="svc-modal-features" class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8" />

         <!-- Stack -->
         <div class="text-[0.6rem] font-mono font-semibold tracking-[0.06em] uppercase text-ink/30 dark:text-white/30 mb-2.5">Tecnologías</div>
         <div id="svc-modal-stack" class="flex flex-wrap gap-2 mb-8" />

         <!-- Process -->
         <div class="text-sm font-bold text-ink dark:text-white mb-4">Proceso de trabajo</div>
         <div id="svc-modal-process" class="flex flex-wrap gap-2 mb-8" />

         <!-- CTA -->
         <div class="flex flex-col sm:flex-row gap-3">
            <a
               href="/#contacto"
               id="svc-modal-cta"
               class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-white text-sm font-semibold transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
            >
               Solicitar cotización
            </a>
            <button type="button" id="svc-modal-close2" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-ink/15 dark:border-white/15 text-ink dark:text-white text-sm font-medium transition-all duration-300 hover:border-ink/30 dark:hover:border-white/30">
               Cerrar
            </button>
         </div>
      </div>
   </div>
</div>

<script>
   import { solutions } from '@/data/solutions.js';

   const iconSVGs = {
      code: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/></svg>`,
      smartphone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`,
      settings: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
      monitor: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
      cloud: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>`,
      palette: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>`,
      bot: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M12 2v4M8 11V9a4 4 0 018 0v2"/><circle cx="9" cy="16" r="1" fill="currentColor"/><circle cx="15" cy="16" r="1" fill="currentColor"/><path d="M9.5 19.5a3 3 0 005 0"/></svg>`,
      book: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>`,
   };

   const colorMap = {
      accent:  '#27a317',
      green:   '#5bbf48',
      purple:  '#1a6911',
      blue:    '#1f8512',
      cyan:    '#8ed87f',
      pink:    '#185313',
      orange:  '#bdeab4',
   };

   const overlay   = document.getElementById('svc-overlay');
   const modal     = document.getElementById('svc-modal');
   const modalBg   = document.getElementById('svc-overlay-bg');
   const closeBtn  = document.getElementById('svc-modal-close');
   const closeBtn2 = document.getElementById('svc-modal-close2');

   const elIcon      = document.getElementById('svc-modal-icon');
   const elTag       = document.getElementById('svc-modal-tag');
   const elTitle     = document.getElementById('svc-modal-title');
   const elSub       = document.getElementById('svc-modal-subtitle');
   const elSubMobile = document.getElementById('svc-modal-subtitle-mobile');
   const elFeatures  = document.getElementById('svc-modal-features');
   const elStack     = document.getElementById('svc-modal-stack');
   const elProcess   = document.getElementById('svc-modal-process');
   const elCta       = document.getElementById('svc-modal-cta');

   function openModal(idx: number) {
      const s = solutions[idx];
      if (!s) return;
      const color = colorMap[s.color] ?? colorMap.accent;

      // Inject icon
      elIcon.innerHTML = iconSVGs[s.icon] ?? '';
      elIcon.style.background = `color-mix(in srgb, ${color} 14%, transparent)`;
      elIcon.style.border = `1px solid color-mix(in srgb, ${color} 20%, transparent)`;
      elIcon.querySelector('svg')?.style.setProperty('color', color);

      // Tag, title, subtitle
      elTag.textContent = s.modal.tag;
      elTag.style.color = color;
      elTitle.textContent = s.title;
      elSub.textContent = s.modal.subtitle;
      elSubMobile.textContent = s.modal.subtitle;

      // Features
      elFeatures.innerHTML = s.modal.features.map(f => `
         <div class="svc-feat rounded-xl border border-ink/10 dark:border-white/10 bg-zinc-50 dark:bg-zinc-800/60 p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-[${color}]/30">
            <div class="flex items-center gap-2 mb-1.5 text-sm font-bold text-ink dark:text-white">
               <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:${color}"></span>
               ${f.t}
            </div>
            <p class="text-xs text-ink/55 dark:text-white/50 leading-relaxed pl-3.5">${f.d}</p>
         </div>
      `).join('');

      // Stack
      elStack.innerHTML = s.modal.stack.map(tag => `
         <span class="inline-flex items-center text-[0.62rem] font-mono px-2.5 py-1.5 rounded-lg border border-ink/10 dark:border-white/10 text-ink/55 dark:text-white/45 bg-zinc-50 dark:bg-zinc-800/50 transition-all duration-200 hover:border-[${color}]/40 hover:text-[${color}]">${tag}</span>
      `).join('');

      // Process
      elProcess.innerHTML = s.modal.process.map(step => `
         <span class="inline-flex items-center gap-2 text-[0.62rem] font-mono px-3 py-1.5 rounded-lg border border-ink/10 dark:border-white/10 text-ink/55 dark:text-white/45 bg-zinc-50 dark:bg-zinc-800/50 transition-all duration-200 hover:border-[${color}]/40 hover:text-[${color}]">
            <span class="font-semibold" style="color:${color};opacity:.7">${step.n}</span>
            ${step.l}
            <span class="opacity-50">${step.t}</span>
         </span>
      `).join('');

      // CTA color
      elCta.style.background = color;
      elCta.style.boxShadow = `0 4px 20px color-mix(in srgb, ${color} 30%, transparent)`;

      // Show overlay
      document.body.style.overflow = 'hidden';
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100');
      requestAnimationFrame(() => {
         modal.classList.remove('opacity-0', 'translate-y-8', 'md:scale-95');
         modal.classList.add('opacity-100', 'translate-y-0', 'md:scale-100');
         modal.scrollTop = 0;
      });
   }

   function closeModal() {
      modal.classList.add('opacity-0', 'translate-y-8');
      modal.classList.remove('opacity-100', 'translate-y-0', 'md:scale-100');
      modal.classList.add('md:scale-95');
      setTimeout(() => {
         overlay.classList.add('opacity-0', 'pointer-events-none');
         overlay.classList.remove('opacity-100');
         document.body.style.overflow = '';
      }, 300);
   }

   // Card click handlers
   document.querySelectorAll<HTMLElement>('.svc-card').forEach(card => {
      card.addEventListener('click', () => {
         const idx = parseInt(card.dataset.idx ?? '0');
         openModal(idx);
      });
   });

   closeBtn?.addEventListener('click', closeModal);
   closeBtn2?.addEventListener('click', closeModal);
   modalBg?.addEventListener('click', closeModal);
   document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>
