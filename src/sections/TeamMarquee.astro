---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Tag from '@components/ui/Tag.astro';
import { team } from '@/data/team.js';

const items = [...team, ...team];
---

<section class="py-20 md:py-28 bg-zinc-50/40 dark:bg-zinc-900/40 overflow-hidden transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10 mb-12 md:mb-16">
      <SectionHeading
         eyebrow="Equipo"
         title="El equipo detrás de tu proyecto"
         subtitle="Ingenieros y diseñadores que suman experiencia en cada proyecto."
         align="center"
      />
   </div>

   <div class="relative marquee-pause">
      <div class="pointer-events-none absolute inset-y-0 left-0 w-24 z-10 bg-gradient-to-r from-zinc-50/90 dark:from-zinc-900/90 to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-24 z-10 bg-gradient-to-l from-zinc-50/90 dark:from-zinc-900/90 to-transparent"></div>

      <div class="marquee-track animate-marquee gap-5 py-2">
         {
            items.map((m) => (
               <article class="flex-shrink-0 w-[280px] sm:w-[320px] rounded-2xl border border-ink/10 dark:border-white/10 bg-white dark:bg-zinc-900 p-5 hover:border-accent-500/40 transition-colors">
                  <div class="aspect-square w-full rounded-xl overflow-hidden mb-5 bg-zinc-100 dark:bg-zinc-800">
                     <img
                        src={m.avatar}
                        alt={m.name}
                        loading="lazy"
                        class="w-full h-full object-cover dark:opacity-95"
                     />
                  </div>
                  <h3 class="text-lg font-bold text-ink dark:text-white leading-tight">{m.name}</h3>
                  <p class="text-xs text-accent-600 dark:text-accent-400 font-medium mt-1">{m.role}</p>
                  <ul class="mt-4 space-y-1.5">
                     {m.skills.map((s) => (
                        <li class="text-xs text-ink-muted dark:text-white/60 flex items-start gap-2">
                           <span class="w-1 h-1 rounded-full bg-accent-500 mt-1.5 flex-shrink-0" />
                           {s}
                        </li>
                     ))}
                  </ul>
                  <div class="mt-4 pt-4 border-t border-ink/5 dark:border-white/10 flex flex-wrap gap-1.5">
                     {m.tech.map((t) => <Tag>{t}</Tag>)}
                  </div>
               </article>
            ))
         }
      </div>
   </div>
</section>
