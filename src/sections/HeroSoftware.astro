---
import Button from '@components/ui/Button.astro';
import DashboardMock from '@sections/DashboardMock.astro';
---

<section class="relative overflow-hidden bg-white dark:bg-zinc-950 pt-12 pb-20 sm:pt-16 sm:pb-24 md:pt-24 md:pb-32 transition-colors duration-300">
   <!-- Background grid pattern -->
   <div class="absolute inset-0 pointer-events-none opacity-[0.04] dark:opacity-[0.08] text-ink dark:text-white" aria-hidden="true">
      <svg width="100%" height="100%">
         <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
               <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
            </pattern>
         </defs>
         <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
   </div>

   <!-- Decorative orb -->
   <div class="absolute top-20 -left-32 w-72 h-72 sm:w-96 sm:h-96 rounded-full bg-accent-200/30 dark:bg-accent-500/15 blur-3xl pointer-events-none" aria-hidden="true"></div>
   <div class="absolute bottom-0 -right-32 w-72 h-72 sm:w-96 sm:h-96 rounded-full bg-brand-200/30 dark:bg-brand-500/15 blur-3xl pointer-events-none" aria-hidden="true"></div>

   <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-6 md:px-10 grid lg:grid-cols-2 gap-10 sm:gap-12 lg:gap-16 items-center">
      <!-- Copy -->
      <div class="min-w-0">
         <span class="inline-flex items-center gap-2 rounded-full border border-ink/10 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-1.5 text-xs font-medium text-ink-muted dark:text-white/60 reveal">
            <span class="relative flex h-2 w-2">
               <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-400 opacity-75"></span>
               <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-500"></span>
            </span>
            8 años digitalizando empresas
         </span>

         <h1 class="mt-5 text-[2rem] leading-[1.1] sm:text-5xl sm:leading-[1.05] md:text-6xl lg:text-7xl font-bold tracking-tight text-ink dark:text-white reveal delay-100">
            Software
            <span class="font-mono whitespace-nowrap">
               <span>{'{ '}</span><span class="bg-gradient-to-r from-accent-500 to-accent-300 bg-clip-text text-transparent">a medida</span><span>{' }'}</span>
            </span>
         </h1>

         <p class="mt-5 sm:mt-6 text-base md:text-lg text-ink-muted dark:text-white/60 leading-relaxed max-w-xl reveal delay-200">
            Transformamos ideas en software de alto rendimiento. Expertos en aplicaciones web, móviles,
            escritorio, backend, cloud e inteligencia artificial.
         </p>

         <div class="mt-7 sm:mt-8 flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 reveal delay-300">
            <Button href="/#contacto" variant="primary" size="lg" class="justify-center">Cotizar un proyecto</Button>
            <Button href="/#soluciones" variant="secondary" size="lg" arrow={false} class="justify-center">
               Ver soluciones
            </Button>
         </div>

         <!-- Trust strip -->
         <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-xs text-ink-muted dark:text-white/55 reveal delay-400">
            <div class="flex items-center gap-2">
               <div class="flex -space-x-2">
                  <span class="w-7 h-7 rounded-full bg-accent-100 dark:bg-accent-500/30 border-2 border-white dark:border-zinc-950 flex items-center justify-center text-[10px] font-bold text-accent-700 dark:text-accent-200">JM</span>
                  <span class="w-7 h-7 rounded-full bg-brand-100 dark:bg-brand-500/30 border-2 border-white dark:border-zinc-950 flex items-center justify-center text-[10px] font-bold text-brand-700 dark:text-brand-200">PA</span>
                  <span class="w-7 h-7 rounded-full bg-zinc-100 dark:bg-white/10 border-2 border-white dark:border-zinc-950 flex items-center justify-center text-[10px] font-bold text-ink dark:text-white">JJ</span>
                  <span class="w-7 h-7 rounded-full bg-amber-100 dark:bg-amber-500/30 border-2 border-white dark:border-zinc-950 flex items-center justify-center text-[10px] font-bold text-amber-700 dark:text-amber-200">VM</span>
               </div>
               <span>+4 ingenieros senior</span>
            </div>
            <span class="hidden sm:inline-block w-px h-4 bg-ink/10 dark:bg-white/15"></span>
            <div class="flex items-center gap-1">
               {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                     <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
               ))}
               <span class="ml-1.5 font-medium text-ink dark:text-white">4.9</span>
               <span>en 80+ proyectos</span>
            </div>
         </div>
      </div>

      <!-- Dashboard preview -->
      <div class="reveal-scale delay-200 min-w-0 w-full">
         <DashboardMock />
      </div>
   </div>
</section>
