---
import { siteConfigData } from '@/utils/site-config.jsx';
import { methodology } from '@/data/methodology.js';
---

<section id="contacto" class="relative bg-white dark:bg-zinc-950 py-20 md:py-28 overflow-hidden transition-colors duration-300">
   <!-- Decorative orbs -->
   <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-20 -left-32 w-80 h-80 bg-accent-200/30 dark:bg-accent-500/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 -right-32 w-80 h-80 bg-brand-200/30 dark:bg-brand-500/15 rounded-full blur-3xl"></div>
   </div>

   <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10">
      <!-- Header -->
      <div class="text-center mb-14 reveal">
         <span class="inline-flex items-center gap-2 rounded-full border border-ink/10 dark:border-white/10 bg-white dark:bg-white/5 px-3 py-1 text-xs font-medium text-ink-muted dark:text-white/60">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-500" />
            Hablemos
         </span>
         <h2 class="mt-5 text-3xl md:text-5xl font-bold tracking-tight text-ink dark:text-white leading-tight">
            Cuéntanos sobre tu <span class="font-mono">{'{'}</span><span class="bg-gradient-to-r from-accent-500 to-accent-700 dark:from-accent-300 dark:to-accent-500 bg-clip-text text-transparent">proyecto</span><span class="font-mono">{'}'}</span>
         </h2>
         <p class="mt-4 text-base md:text-lg text-ink-muted dark:text-white/60 max-w-2xl mx-auto">
            Completa el formulario y te respondemos en menos de 24 horas con un plan concreto.
         </p>
      </div>

      <!-- Proceso: Timeline -->
      <div class="mb-16 md:mb-20 reveal">
         <!-- Desktop: horizontal timeline -->
         <div class="hidden md:flex items-start gap-0">
            {
               methodology.map((step, i) => (
                  <div class="flex-1 flex flex-col items-center text-center group">
                     {/* Connector line + node row */}
                     <div class="w-full flex items-center">
                        {/* Left line */}
                        <div class={`flex-1 h-px ${i === 0 ? 'bg-transparent' : 'bg-gradient-to-r from-accent-500/40 to-accent-500/80'}`} />
                        {/* Node */}
                        <div class="relative flex-shrink-0">
                           <div class="w-14 h-14 rounded-full bg-accent-500/10 dark:bg-accent-500/15 border-2 border-accent-500/30 group-hover:border-accent-500 group-hover:bg-accent-500 flex items-center justify-center transition-all duration-300 z-10 relative">
                              <span class="font-mono text-sm font-bold text-accent-600 dark:text-accent-400 group-hover:text-white transition-colors">{step.number}</span>
                           </div>
                           {/* Glow */}
                           <div class="absolute inset-0 rounded-full bg-accent-500/20 blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                        </div>
                        {/* Right line */}
                        <div class={`flex-1 h-px ${i === methodology.length - 1 ? 'bg-transparent' : 'bg-gradient-to-r from-accent-500/80 to-accent-500/40'}`} />
                     </div>
                     {/* Content */}
                     <div class="mt-5 px-4">
                        <h4 class="font-bold text-base text-ink dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">{step.title}</h4>
                        <p class="mt-2 text-sm text-ink-muted dark:text-white/55 leading-relaxed">{step.description}</p>
                        <span class="inline-block mt-3 text-xs font-mono text-accent-600 dark:text-accent-400 bg-accent-500/8 dark:bg-accent-500/15 px-2.5 py-1 rounded-full">{step.duration}</span>
                     </div>
                  </div>
               ))
            }
         </div>

         <!-- Mobile: vertical timeline -->
         <div class="flex md:hidden flex-col gap-0">
            {
               methodology.map((step, i) => (
                  <div class="flex gap-5 group">
                     {/* Left: node + vertical line */}
                     <div class="flex flex-col items-center flex-shrink-0">
                        <div class="relative">
                           <div class="w-12 h-12 rounded-full bg-accent-500/10 dark:bg-accent-500/15 border-2 border-accent-500/30 group-hover:border-accent-500 group-hover:bg-accent-500 flex items-center justify-center transition-all duration-300">
                              <span class="font-mono text-sm font-bold text-accent-600 dark:text-accent-400 group-hover:text-white transition-colors">{step.number}</span>
                           </div>
                        </div>
                        {i < methodology.length - 1 && (
                           <div class="flex-1 w-px bg-gradient-to-b from-accent-500/60 to-accent-500/10 mt-2 min-h-[3rem]" />
                        )}
                     </div>
                     {/* Right: content */}
                     <div class={`pb-8 ${i === methodology.length - 1 ? 'pb-0' : ''}`}>
                        <h4 class="font-bold text-base text-ink dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors mt-2">{step.title}</h4>
                        <p class="mt-1.5 text-sm text-ink-muted dark:text-white/55 leading-relaxed">{step.description}</p>
                        <span class="inline-block mt-2 text-xs font-mono text-accent-600 dark:text-accent-400 bg-accent-500/8 dark:bg-accent-500/15 px-2.5 py-1 rounded-full">{step.duration}</span>
                     </div>
                  </div>
               ))
            }
         </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">
         <!-- Contact cards -->
         <aside class="lg:col-span-2 flex flex-col gap-4">
            <!-- WhatsApp -->
            <a
               href={`https://wa.me/${siteConfigData.contacto.WHATSAPP.replace(/\D/g, '')}`}
               target="_blank"
               rel="noopener noreferrer"
               class="bg-white dark:bg-zinc-900 border border-ink/10 dark:border-white/10 rounded-2xl p-5 flex items-center gap-4 hover:border-accent-500/40 hover:shadow-md transition-all duration-300 group reveal delay-100"
            >
               <div class="w-12 h-12 rounded-xl bg-accent-500 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                     <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                  </svg>
               </div>
               <div class="min-w-0 flex-1">
                  <p class="text-xs font-semibold text-ink-muted dark:text-white/55 uppercase tracking-wider">WhatsApp</p>
                  <p class="text-sm font-semibold text-ink dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">{siteConfigData.contacto.WHATSAPP}</p>
                  <p class="text-xs text-ink-muted dark:text-white/50 mt-0.5">Respuesta inmediata</p>
               </div>
            </a>

            <!-- Email -->
            <a
               href={`mailto:${siteConfigData.contacto.EMAIL}`}
               class="bg-white dark:bg-zinc-900 border border-ink/10 dark:border-white/10 rounded-2xl p-5 flex items-center gap-4 hover:border-accent-500/40 hover:shadow-md transition-all duration-300 group reveal delay-200"
            >
               <div class="w-12 h-12 rounded-xl bg-ink flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
               </div>
               <div class="min-w-0 flex-1">
                  <p class="text-xs font-semibold text-ink-muted dark:text-white/55 uppercase tracking-wider">Email</p>
                  <p class="text-sm font-semibold text-ink dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors break-all">{siteConfigData.contacto.EMAIL}</p>
                  <p class="text-xs text-ink-muted dark:text-white/50 mt-0.5">Respuesta en 24h</p>
               </div>
            </a>

            <!-- Teléfono -->
            <a
               href={`tel:${siteConfigData.contacto.TELEFONO}`}
               class="bg-white dark:bg-zinc-900 border border-ink/10 dark:border-white/10 rounded-2xl p-5 flex items-center gap-4 hover:border-accent-500/40 hover:shadow-md transition-all duration-300 group reveal delay-300"
            >
               <div class="w-12 h-12 rounded-xl bg-zinc-100 border border-ink/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
               </div>
               <div class="min-w-0 flex-1">
                  <p class="text-xs font-semibold text-ink-muted dark:text-white/55 uppercase tracking-wider">Teléfono</p>
                  <p class="text-sm font-semibold text-ink dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">{siteConfigData.contacto.TELEFONO}</p>
                  <p class="text-xs text-ink-muted dark:text-white/50 mt-0.5">Lun - Vie: 9:00 - 18:00</p>
               </div>
            </a>

            <!-- Dirección -->
            <!-- <div class="bg-white dark:bg-zinc-900 border border-ink/10 dark:border-white/10 rounded-2xl p-5 flex items-center gap-4 hover:border-accent-500/40 hover:shadow-md transition-all duration-300 group reveal delay-400">
               <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-ink/10 dark:border-white/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-ink dark:text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                     <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
               </div>
               <div class="min-w-0 flex-1">
                  <p class="text-xs font-semibold text-ink-muted dark:text-white/55 uppercase tracking-wider">Oficina</p>
                  <p class="text-sm font-semibold text-ink dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors mt-0.5 leading-snug">{siteConfigData.contacto.DIRECCION}</p>
               </div>
            </div> -->
         </aside>

         <!-- Form -->
         <div class="lg:col-span-3 bg-white dark:bg-zinc-900 border border-ink/10 dark:border-white/10 rounded-3xl shadow-sm p-6 md:p-8 reveal-right">
            <h3 class="text-xl md:text-2xl font-bold text-ink dark:text-white mb-1">Envíanos un mensaje</h3>
            <p class="text-ink-muted dark:text-white/60 text-sm mb-5">
               Cuéntanos qué necesitas y te enviamos una propuesta concreta.
            </p>

            <p id="contact-form-status" class="hidden text-sm mb-4 rounded-lg px-4 py-2.5 border"></p>

            <form name="contacto" class="space-y-5" novalidate>
               <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                     <label class="block text-xs font-semibold text-ink dark:text-white mb-1.5">Nombre completo <span class="text-accent-500">*</span></label>
                     <input
                        type="text"
                        name="nombre"
                        required
                        placeholder="María García"
                        class="w-full px-4 py-3 rounded-xl border border-ink/10 dark:border-white/10 focus:border-accent-500 focus:ring-4 focus:ring-accent-500/10 outline-none transition-all text-sm text-ink dark:text-white placeholder-ink-muted/50 dark:placeholder-white/40 bg-white dark:bg-zinc-950/60"
                     />
                  </div>
                  <div>
                     <label class="block text-xs font-semibold text-ink dark:text-white mb-1.5">Correo electrónico <span class="text-accent-500">*</span></label>
                     <input
                        type="email"
                        name="email"
                        required
                        placeholder="tu@email.com"
                        class="w-full px-4 py-3 rounded-xl border border-ink/10 dark:border-white/10 focus:border-accent-500 focus:ring-4 focus:ring-accent-500/10 outline-none transition-all text-sm text-ink dark:text-white placeholder-ink-muted/50 dark:placeholder-white/40 bg-white dark:bg-zinc-950/60"
                     />
                  </div>
               </div>

               <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                     <label class="block text-xs font-semibold text-ink dark:text-white mb-1.5">Teléfono / WhatsApp</label>
                     <input
                        type="tel"
                        name="telefono"
                        placeholder="+52 55 1234 5678"
                        inputmode="numeric"
                        maxlength="15"
                        pattern="[0-9]{0,15}"
                        class="w-full px-4 py-3 rounded-xl border border-ink/10 dark:border-white/10 focus:border-accent-500 focus:ring-4 focus:ring-accent-500/10 outline-none transition-all text-sm text-ink dark:text-white placeholder-ink-muted/50 dark:placeholder-white/40 bg-white dark:bg-zinc-950/60"
                     />
                  </div>
                  <div>
                     <label class="block text-xs font-semibold text-ink dark:text-white mb-1.5">Tipo de proyecto</label>
                     <select
                        name="servicio"
                        class="w-full px-4 py-3 rounded-xl border border-ink/10 dark:border-white/10 focus:border-accent-500 focus:ring-4 focus:ring-accent-500/10 outline-none transition-all text-sm text-ink dark:text-white bg-white dark:bg-zinc-950/60"
                     >
                        <option value="" disabled selected>Selecciona uno</option>
                        <option value="app-movil">Aplicación móvil (iOS/Android)</option>
                        <option value="plataforma-web">Plataforma web / SaaS</option>
                        <option value="crm-erp">CRM / ERP</option>
                        <option value="cloud">Cloud e integraciones</option>
                        <option value="ia-agentes">IA y Agentes / Automatizaciones</option>
                        <option value="ui-ux">Diseño UI/UX</option>
                        <option value="consultoria">Consultoría técnica</option>
                        <option value="otro">Otro</option>
                     </select>
                  </div>
               </div>

               <div>
                  <label class="block text-xs font-semibold text-ink dark:text-white mb-1.5">Cuéntanos tu idea <span class="text-accent-500">*</span></label>
                  <textarea
                     name="mensaje"
                     required
                     rows="5"
                     placeholder="¿Qué problema quieres resolver? ¿Para quién es el producto? ¿Tienes referencias?"
                     class="w-full px-4 py-3 rounded-xl border border-ink/10 dark:border-white/10 focus:border-accent-500 focus:ring-4 focus:ring-accent-500/10 outline-none transition-all text-sm text-ink dark:text-white placeholder-ink-muted/50 dark:placeholder-white/40 bg-white dark:bg-zinc-950/60 resize-none"
                  ></textarea>
               </div>

               <div class="flex items-start gap-3">
                  <input
                     type="checkbox"
                     id="privacy"
                     name="privacidad"
                     required
                     class="mt-0.5 w-4 h-4 rounded border-ink/20 dark:border-white/20 text-accent-500 focus:ring-accent-500 cursor-pointer bg-white dark:bg-zinc-950"
                  />
                  <label for="privacy" class="text-xs text-ink-muted dark:text-white/60 cursor-pointer leading-relaxed">
                     Acepto la
                     <a href="/privacypolicy" class="text-accent-600 dark:text-accent-400 underline hover:text-accent-700 dark:hover:text-accent-300 transition-colors">
                        Política de privacidad
                     </a>
                     y autorizo el contacto sobre mi proyecto.
                  </label>
               </div>

               <button
                  type="submit"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-ink dark:bg-accent-500 hover:bg-zinc-800 dark:hover:bg-accent-600 active:scale-[0.98] text-white font-semibold px-8 py-3.5 rounded-full transition-all duration-200 shadow-sm hover:shadow-lg text-sm group"
               >
                  Enviar mensaje
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
               </button>
            </form>
         </div>
      </div>
   </div>
</section>

<script>
   const form = document.querySelector('form[name="contacto"]');
   const statusEl = document.getElementById('contact-form-status');

   if (form) {
      const phoneInput = form.querySelector('input[name="telefono"]');

      if (phoneInput instanceof HTMLInputElement) {
         phoneInput.addEventListener('input', () => {
            let value = phoneInput.value.replace(/\D/g, '');
            if (value.length > 15) {
               value = value.slice(0, 15);
            }
            phoneInput.value = value;
         });
      }

      form.addEventListener('submit', async (event) => {
         event.preventDefault();

         if (!statusEl) return;

         const htmlForm = form instanceof HTMLFormElement ? form : null;
         const submitButton = htmlForm?.querySelector('button[type="submit"]') ?? null;
         const originalText = submitButton ? submitButton.textContent : '';

         statusEl.classList.remove('hidden');
         statusEl.textContent = 'Enviando tu mensaje...';
         statusEl.className = 'text-sm mb-4 rounded-lg px-4 py-2.5 border border-accent-200 bg-accent-50 text-accent-700';

         if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = true;
            submitButton.textContent = 'Enviando...';
         }

         try {
            if (!htmlForm) {
               throw new Error('No se encontró el formulario de contacto.');
            }

            const formData = new FormData(htmlForm);

            const nombre = formData.get('nombre')?.toString().trim() || '';
            const email = formData.get('email')?.toString().trim() || '';
            const telefono = formData.get('telefono')?.toString().trim() || '';
            const mensaje = formData.get('mensaje')?.toString().trim() || '';
            const servicio = formData.get('servicio')?.toString().trim() || '';

            if (!nombre || !email || !mensaje) {
               throw new Error('Por favor completa los campos obligatorios.');
            }

            const subject = 'Nueva solicitud de proyecto desde el sitio web';

            const response = await fetch('/.netlify/functions/contact-form', {
               method: 'POST',
               headers: {
                  'Content-Type': 'application/json',
               },
               body: JSON.stringify({
                  name: nombre,
                  email,
                  phone: telefono,
                  message: mensaje,
                  subject,
                  service: servicio,
               }),
            });

            const result = await response.json().catch(() => ({}));

            if (!response.ok || !result.success) {
               throw new Error(result?.error || 'Hubo un problema al enviar tu mensaje.');
            }

            try {
               const metaUtils = window['metaPixelUtils'];

               if (typeof window !== 'undefined' && metaUtils && metaUtils.trackEvent) {
                  const { trackEvent } = metaUtils;

                  const parts = nombre.split(' ');
                  const firstName = parts[0] || '';
                  const lastName = parts.slice(1).join(' ') || '';

                  let userCountry = 'MX';
                  if (navigator.language) {
                     const locale = navigator.language.toLowerCase();
                     if (locale.includes('mx') || locale.includes('es-mx')) userCountry = 'MX';
                     else if (locale.includes('co')) userCountry = 'CO';
                     else if (locale.includes('ar')) userCountry = 'AR';
                  }

                  const timestamp = Date.now();

                  trackEvent(
                     'Lead',
                     {
                        content_name: 'Contact Form Submission',
                        content_category: 'lead_generation',
                        content_type: 'contact_form',
                        lead_type: 'form_contact',
                        lead_source: 'website_form',
                        page_url: window.location.href,
                        page_title: document.title,
                        referrer_url: document.referrer || 'direct',
                        service: servicio || 'general',
                        value: 80,
                        currency: 'MXN',
                        country: userCountry,
                        campaign_source: new URLSearchParams(window.location.search).get('utm_source') || 'organic',
                        campaign_medium: new URLSearchParams(window.location.search).get('utm_medium') || 'website',
                        campaign_name:
                           new URLSearchParams(window.location.search).get('utm_campaign') || 'contact_form',
                        session_id: sessionStorage.getItem('session_id') || `session-${timestamp}`,
                     },
                     {
                        em: email ? [email] : [],
                        ph: telefono ? [telefono.replace(/\D/g, '')] : [],
                        fn: firstName ? [firstName] : [],
                        ln: lastName ? [lastName] : [],
                        country: [userCountry],
                     },
                  );
               }
            } catch (e) {
               // Silenciar errores de tracking para no afectar la UX del formulario
            }

            statusEl.textContent = '¡Gracias! Te respondemos en menos de 24 horas.';
            statusEl.className = 'text-sm mb-4 rounded-lg px-4 py-2.5 border border-accent-300 bg-accent-50 text-accent-700';

            if (htmlForm instanceof HTMLFormElement) {
               htmlForm.reset();
            }
         } catch (error) {
            statusEl.textContent = error?.message || 'No pudimos enviar tu mensaje. Inténtalo de nuevo más tarde.';
            statusEl.className = 'text-sm mb-4 rounded-lg px-4 py-2.5 border border-red-200 bg-red-50 text-red-700';
         } finally {
            const submitButton = htmlForm.querySelector('button[type="submit"]');
            if (submitButton instanceof HTMLButtonElement) {
               submitButton.disabled = false;
               submitButton.textContent = originalText || 'Enviar mensaje';
            }
         }
      });
   }
</script>
