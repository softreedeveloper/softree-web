---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { testimonials } from '@/data/testimonials.js';

// Duplicamos para loop infinito sin saltos
const items = [...testimonials, ...testimonials];
---

<section class="py-20 md:py-28 bg-white dark:bg-zinc-950 overflow-hidden transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10 mb-12 md:mb-16">
      <SectionHeading
         eyebrow="Testimonios"
         title="Lo que dicen nuestros clientes"
         subtitle="Resultados reales de empresas que confiaron su software a Softree."
         align="center"
      />
   </div>

   <!-- Fade edges -->
   <div class="relative marquee-pause">
      <div class="pointer-events-none absolute inset-y-0 left-0 w-24 z-10 bg-gradient-to-r from-white dark:from-zinc-950 to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-24 z-10 bg-gradient-to-l from-white dark:from-zinc-950 to-transparent"></div>

      <div class="marquee-track animate-marquee-slow gap-5 py-2">
         {
            items.map((t) => (
               <article class="flex-shrink-0 w-[320px] sm:w-[380px] rounded-2xl border border-ink/10 dark:border-white/10 bg-white dark:bg-zinc-900 p-6 hover:border-accent-500/40 transition-colors">
                  <div class="flex items-center gap-1 mb-4">
                     {Array.from({ length: t.rating }).map(() => (
                        <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                           <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                     ))}
                  </div>
                  <p class="text-sm md:text-[15px] text-ink dark:text-white/85 leading-relaxed mb-6">"{t.quote}"</p>
                  <div class="flex items-center gap-3 pt-5 border-t border-ink/5 dark:border-white/10">
                     <img
                        src={t.avatar}
                        alt={t.name}
                        loading="lazy"
                        class="w-10 h-10 rounded-full object-cover bg-zinc-100 dark:bg-zinc-800"
                     />
                     <div class="min-w-0">
                        <p class="text-sm font-semibold text-ink dark:text-white truncate">{t.name}</p>
                        <p class="text-xs text-ink-muted dark:text-white/55 truncate">
                           {t.title}, {t.company} · {t.country}
                        </p>
                     </div>
                  </div>
               </article>
            ))
         }
      </div>
   </div>
</section>
