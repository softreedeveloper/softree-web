---
import { siteConfigData } from '@/utils/site-config.jsx';

const stats = [
   { value: '500+', label: 'Clientes satisfechos' },
   { value: '10+', label: 'Años de experiencia' },
   { value: '98%', label: 'Satisfacción' },
];
---

<section class="hero-section relative min-h-screen flex flex-col overflow-hidden">
   <!-- ── Imagen de fondo + overlay ── -->
   <div class="absolute inset-0 z-0">
      <img
         src="img/banner-gal.jpeg?w=1600&q=85"
         alt="Fondo de limpieza profesional"
         class="w-full h-full object-cover"
         loading="eager"
         aria-hidden="true"
      />
      <!-- Overlay degradado oscuro a derecha -->
      <div class="absolute inset-0 bg-gradient-to-l from-brand-700/90 via-brand-400/75 to-brand-800/20"></div>
      <!-- Tinte inferior para legibilidad de stats -->
      <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-brand-950/80 to-transparent"></div>
   </div>

   <!-- ── Ruido / textura sutil ── -->
   <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none hero-noise"></div>

   <!-- ── Orbs de luz ── -->
   <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-20 -right-20 w-96 h-96 bg-brand-500 rounded-full blur-3xl opacity-20"></div>
      <div class="absolute top-1/3 right-1/4 w-64 h-64 bg-brand-400 rounded-full blur-3xl opacity-10"></div>
   </div>

   <!-- ── Contenido principal ── -->
   <div
      class="relative z-10 flex-1 flex items-center justify-end px-6 md:px-12 lg:px-20 pt-28 pb-16 max-w-7xl mx-auto w-full"
   >
      <div class="max-w-2xl text-right">
         <!-- Chip -->
         <div class="flex items-center justify-end gap-2 mb-6" data-aos="fade-down" data-aos-duration="600">
            <span
               class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/20 text-white/90 text-xs font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full"
            >
               <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
               Servicios profesionales · CDMX
            </span>
         </div>

         <!-- Headline -->
         <h1
            class="text-5xl md:text-6xl xl:text-7xl font-black text-white leading-[1.05] tracking-tight mb-6"
            data-aos="fade-up"
            data-aos-duration="700"
            data-aos-delay="100"
         >
            Espacios<br />
            <span class="hero-gradient-text">impecables.</span><br />
            Siempre.
         </h1>

         <!-- Subtítulo -->
         <p
            class="text-white/70 text-lg md:text-xl leading-relaxed max-w-lg mb-10"
            data-aos="fade-up"
            data-aos-duration="700"
            data-aos-delay="200"
         >
            Limpieza profesional para hogares, oficinas y empresas.<br class="hidden md:block" />
            Personal certificado y resultados garantizados en cada visita.
         </p>

         <!-- CTAs -->
         <div
            class="flex flex-wrap justify-end gap-4 mb-14"
            data-aos="fade-up"
            data-aos-duration="700"
            data-aos-delay="300"
         >
            <a
               href={`https://wa.me/${siteConfigData.contacto.WHATSAPP.replace(/\D/g, '')}`}
               target="_blank"
               rel="noopener noreferrer"
               class="group inline-flex items-center gap-2.5 bg-green-500 text-white font-bold px-8 py-4 rounded-full transition-all duration-300 hover:bg-green-600 hover:scale-105 shadow-xl shadow-brand-950/30"
            >
               <!-- WhatsApp icon -->
               <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 24 24">
                  <path
                     d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path>
               </svg>
               Cotiza por WhatsApp
            </a>
            <a
               href="#servicios"
               class="inline-flex items-center gap-2 border border-white/30 text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 hover:bg-white/10 backdrop-blur-sm"
            >
               Ver servicios
               <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
               </svg>
            </a>
         </div>

         <!-- Tags badge row -->
         <div class="flex flex-wrap justify-end gap-2" data-aos="fade-up" data-aos-duration="600" data-aos-delay="400">
            {
               ['✓ Personal certificado', '✓ Productos ecológicos', '✓ Sin contratos forzosos'].map((tag) => (
                  <span class="text-white/60 text-xs font-medium">{tag}</span>
               ))
            }
         </div>
      </div>
   </div>

   <!-- ── Stats bar flotante en la parte inferior ── -->
   <div
      class="relative z-10 w-full px-6 md:px-12 lg:px-20 pb-10 max-w-7xl mx-auto flex justify-end"
      data-aos="fade-up"
      data-aos-delay="500"
   >
      <div class="grid grid-cols-3 gap-4 max-w-lg w-full">
         {
            stats.map((s) => (
               <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl px-5 py-4 text-center">
                  <p class="text-2xl md:text-3xl font-black text-white">{s.value}</p>
                  <p class="text-white/60 text-xs mt-0.5 leading-tight">{s.label}</p>
               </div>
            ))
         }
      </div>
   </div>

   <!-- ── Scroll indicator ── -->
   <div class="absolute bottom-6 left-8 z-10 hidden md:flex flex-col items-center gap-2 opacity-50">
      <span class="text-white text-[10px] tracking-[0.2em] uppercase rotate-90 origin-center translate-x-4">Scroll</span
      >
      <div class="w-px h-12 bg-white scroll-line"></div>
   </div>
</section>

<style>
   .hero-gradient-text {
      background: linear-gradient(90deg, #1b4e8c, #2171cb);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
   }

   .hero-noise {
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      background-repeat: repeat;
      background-size: 128px;
   }

   .scroll-line {
      animation: scrollDown 1.8s ease-in-out infinite;
   }

   @keyframes scrollDown {
      0% {
         transform: scaleY(0);
         transform-origin: top;
      }
      50% {
         transform: scaleY(1);
         transform-origin: top;
      }
      51% {
         transform: scaleY(1);
         transform-origin: bottom;
      }
      100% {
         transform: scaleY(0);
         transform-origin: bottom;
      }
   }
</style>
