---
---

<section class="py-20 md:py-28 bg-ink relative overflow-hidden">
   <!-- Decorative SVG pattern -->
   <div class="absolute inset-0 opacity-[0.04] pointer-events-none" aria-hidden="true">
      <svg width="100%" height="100%">
         <defs>
            <pattern id="dots" width="30" height="30" patternUnits="userSpaceOnUse">
               <circle cx="2" cy="2" r="1.5" fill="white" />
            </pattern>
         </defs>
         <rect width="100%" height="100%" fill="url(#dots)" />
      </svg>
   </div>

   <!-- Glow -->
   <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-accent-500/20 blur-[120px] pointer-events-none" aria-hidden="true"></div>

   <div class="relative z-10 max-w-5xl mx-auto px-6 md:px-10 text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-white/70 reveal">
         <span class="h-1.5 w-1.5 rounded-full bg-accent-500" />
         Filosofía
      </span>
      <h2 class="mt-6 text-3xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight reveal delay-100">
         No eres un cliente más.
         <span class="block bg-gradient-to-r from-accent-300 to-accent-500 bg-clip-text text-transparent">
            Eres nuestro partner.
         </span>
      </h2>
      <p class="mt-6 text-base md:text-lg text-white/70 leading-relaxed max-w-2xl mx-auto reveal delay-200">
         Escuchamos, proponemos y entregamos. Sin vueltas, sin cajas negras, sin sorpresas.
      </p>
   </div>
</section>
