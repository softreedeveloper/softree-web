---
const pillars = [
   {
      icon: '🎯',
      title: 'Misión',
      text: 'Brindar la satisfacción del cliente, haciendo realidad las expectativas en cualquier trabajo que apliquemos.',
   },
   {
      icon: '🔭',
      title: 'Visión',
      text: 'Posicionarnos entre las mejores empresas proveedoras en servicios de limpieza y mantenimiento apoyando el medio ambiente.',
   },
   {
      icon: '🎓',
      title: 'Capacitación',
      text: 'Brindamos capacitación constante, actualizando con temas a la vanguardia, para dar el mejor servicio.',
   },
   {
      icon: '🌿',
      title: 'Productos',
      text: 'Proporcionamos y aplicamos productos de calidad en apoyo al medioambiente.',
   },
   { icon: '📋', title: 'Bitácora y reportes', text: 'Damos un seguimiento administrativo para un mayor control.' },
   { icon: '✅', title: 'Servicios', text: 'Los servicios se adaptan a las necesidades del cliente.' },
];
---

<section
   id="nosotros"
   class="relative bg-gradient-to-br from-white via-brand-50/20 to-white py-24 px-4 md:px-12 overflow-hidden"
>
   <!-- Fondo decorativo con difuminaciones -->
   <div class="absolute inset-0 pointer-events-none">
      <div
         class="absolute top-0 right-0 w-2/5 h-full bg-gradient-to-bl from-brand-100/60 via-brand-50/40 to-transparent rounded-bl-[80px] hidden lg:block"
      >
      </div>
      <div class="absolute top-16 right-10 w-48 h-48 bg-brand-400 rounded-full blur-3xl opacity-15"></div>
      <div class="absolute bottom-16 left-12 w-56 h-56 bg-brand-500 rounded-full blur-3xl opacity-10"></div>
      <div class="absolute top-1/2 left-1/4 w-40 h-40 bg-brand-300 rounded-full blur-3xl opacity-20"></div>
   </div>

   <div class="relative z-10 max-w-6xl mx-auto">
      <!-- Header nosotros -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center mb-20">
         <!-- Texto -->
         <div data-aos="fade-right" data-aos-duration="900">
            <span
               class="inline-block bg-brand-100 text-brand-800 text-xs font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full mb-5"
            >
               Quiénes somos
            </span>
            <h2 class="text-4xl md:text-5xl font-extrabold text-dark leading-tight mb-5">
               Limpieza profesional –<br />
               <em class="not-italic text-brand-600">con propósito real.</em>
            </h2>
            <p class="text-gray-600 text-lg leading-relaxed max-w-lg">
               Somos Softree, una empresa mexicana especializada en servicios de limpieza y mantenimiento.
               Trabajamos con compromiso, calidad y respeto al medio ambiente en cada proyecto.
            </p>
         </div>

         <!-- Imagen -->
         <div class="relative" data-aos="fade-left" data-aos-duration="900" data-aos-delay="100">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-brand-900/15 aspect-[4/3]">
               <img
                  src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=85"
                  alt="Equipo Softree trabajando"
                  class="w-full h-full object-cover"
                  loading="lazy"
               />
               <div class="absolute inset-0 bg-gradient-to-t from-brand-800/20 via-transparent to-transparent"></div>
            </div>
            <div
               class="absolute -bottom-5 -left-5 bg-brand-500 text-white rounded-2xl shadow-xl px-6 py-4 hidden md:block"
               data-aos="fade-up"
               data-aos-delay="400"
            >
               <p class="text-3xl font-extrabold" data-count="10" data-suffix="+">10+</p>
               <p class="text-brand-100 text-xs mt-0.5">Años de experiencia</p>
            </div>
         </div>
      </div>

      <!-- Pilares -->
      <div class="text-center mb-12" data-aos="fade-up">
         <span class="text-brand-500 text-sm font-semibold tracking-widest uppercase">Lo que nos define</span>
         <h3 class="mt-3 text-3xl font-extrabold text-dark">Nuestros pilares</h3>
         <p class="mt-3 text-gray-500 max-w-lg mx-auto text-sm">
            Cada aspecto de nuestro trabajo está guiado por valores concretos que garantizan resultados excepcionales.
         </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
         {
            pillars.map((p, i) => (
               <div
                  class="group bg-white border border-gray-100 rounded-3xl p-8 shadow-sm hover:shadow-2xl hover:shadow-brand-500/10 hover:-translate-y-2 transition-all duration-300 cursor-default relative overflow-hidden"
                  data-aos="fade-up"
                  data-aos-delay={i * 80}
               >
                  <div class="absolute inset-0 bg-gradient-to-br from-brand-50/0 to-brand-50/50 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                  <div class="relative z-10">
                     <div class="w-14 h-14 bg-brand-50 rounded-2xl flex items-center justify-center text-3xl mb-5 group-hover:bg-brand-300 group-hover:scale-110 transition-all duration-300">
                        <span class="group-hover:scale-110 transition-transform duration-300">{p.icon}</span>
                     </div>
                     <h4 class="text-xl font-extrabold text-dark mb-3 group-hover:text-brand-700 transition-colors duration-300">
                        {p.title}
                     </h4>
                     <p class="text-gray-500 leading-relaxed text-sm">{p.text}</p>
                     <div class="mt-6 h-1 w-12 bg-brand-400 rounded-full group-hover:w-full group-hover:bg-brand-600 transition-all duration-500" />
                  </div>
               </div>
            ))
         }
      </div>
   </div>
</section>
