---
const industries = [
   { name: 'Residencias', icon: '🏠' },
   { name: 'Oficinas', icon: '🏢' },
   { name: 'Restaurantes', icon: '🍽️' },
   { name: 'Hoteles', icon: '🏨' },
   { name: 'Clínicas', icon: '🏥' },
   { name: 'Eventos', icon: '🎉' },
];
---

<section class="relative bg-gradient-to-br from-brand-50 via-brand-50/50 to-white py-24 px-4 md:px-12 overflow-hidden">
   <!-- Efectos de difuminación -->
   <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-10 left-1/3 w-64 h-64 bg-brand-400 rounded-full blur-3xl opacity-10"></div>
      <div class="absolute bottom-20 right-1/3 w-72 h-72 bg-brand-500 rounded-full blur-3xl opacity-10"></div>
   </div>
   <div class="relative z-10 max-w-5xl mx-auto">
      <div class="text-center mb-12" data-aos="fade-up">
         <span class="text-brand-600 text-sm font-semibold tracking-widest uppercase">Sectores que atendemos</span>
         <h2 class="mt-3 text-3xl md:text-4xl font-extrabold text-dark leading-tight">
            Soluciones de limpieza para<br />
            <em class="not-italic text-brand-700">diversas industrias.</em>
         </h2>
         <p class="mt-4 text-gray-500 max-w-lg mx-auto">
            Listo para marcar la diferencia. Descubre cómo Softree puede potenciar la imagen de tu sector.
         </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
         {
            industries.map((ind, i) => (
               <div
                  class="bg-white rounded-2xl p-5 text-center shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border border-brand-100 cursor-default"
                  data-aos="zoom-in"
                  data-aos-delay={i * 60}
               >
                  <span class="text-3xl">{ind.icon}</span>
                  <p class="mt-2 text-sm font-semibold text-dark">{ind.name}</p>
               </div>
            ))
         }
      </div>
   </div>
</section>
