---
import { features } from '@/data/company-stats.js';

const iconPaths = {
   layers: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
   'shield-check': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
   key: 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z',
};
---

<section class="py-20 md:py-28 bg-white dark:bg-zinc-950 transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="grid md:grid-cols-3 gap-8 md:gap-12">
         {
            features.map((f, i) => (
               <div class={`group reveal delay-${(i + 1) * 100}`}>
                  <div class="w-14 h-14 rounded-2xl bg-accent-50 dark:bg-accent-500/10 border border-accent-100 dark:border-accent-500/20 flex items-center justify-center mb-5 group-hover:bg-accent-500 group-hover:border-accent-500 transition-colors duration-300">
                     <svg class="w-6 h-6 text-accent-600 dark:text-accent-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[f.icon]} />
                     </svg>
                  </div>
                  <h3 class="text-xl md:text-2xl font-bold text-ink dark:text-white mb-3 leading-tight">{f.title}</h3>
                  <p class="text-sm md:text-base text-ink-muted dark:text-white/60 leading-relaxed">{f.description}</p>
               </div>
            ))
         }
      </div>
   </div>
</section>
