---
// Mock de dashboard 100% HTML/SVG, sin librerías. Mostrado en el Hero.
const metrics = [
   { label: 'Ingresos', value: '$42.8K', delta: '+18%', color: 'text-accent-600', bg: 'bg-accent-50' },
   { label: 'Clientes', value: '1,247', delta: '+5.2%', color: 'text-accent-600', bg: 'bg-accent-50' },
   { label: 'Órdenes', value: '384', delta: '+12%', color: 'text-accent-600', bg: 'bg-accent-50' },
   { label: 'Satisfacción', value: '96.1%', delta: '+2.1%', color: 'text-accent-600', bg: 'bg-accent-50' },
];
const tabs = ['Overview', 'Inventario', 'Reservas', 'Ventas', 'Clientes', 'Reportes'];
---

<div class="relative">
   <!-- Sombra suave detrás -->
   <div class="absolute inset-0 -m-4 bg-gradient-to-br from-accent-400/10 via-brand-200/10 to-transparent dark:from-accent-500/15 dark:via-brand-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

   <div class="relative bg-white dark:bg-zinc-900 rounded-2xl border border-ink/10 dark:border-white/10 shadow-xl shadow-ink/5 dark:shadow-black/40 overflow-hidden">
      <!-- Browser chrome -->
      <div class="flex items-center justify-between px-4 py-3 border-b border-ink/5 dark:border-white/5 bg-zinc-50/80 dark:bg-zinc-950/60">
         <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
         </div>
         <div class="hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-md bg-white dark:bg-zinc-900 border border-ink/5 dark:border-white/10 text-[10px] font-mono text-ink-muted dark:text-white/55">
            <svg class="w-3 h-3 text-accent-600 dark:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
               <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
            </svg>
            app.softree.com.mx/dashboard
         </div>
         <span class="text-[10px] font-mono text-ink-muted dark:text-white/55">v2.4</span>
      </div>

      <!-- Tabs -->
      <div class="px-4 pt-3 flex gap-1 overflow-x-auto scrollbar-hide border-b border-ink/5 dark:border-white/5">
         {
            tabs.map((tab, i) => (
               <button
                  class={`px-3 py-2 text-xs font-medium whitespace-nowrap rounded-t-md transition-colors ${i === 0 ? 'text-ink dark:text-white bg-white dark:bg-zinc-900 border-x border-t border-ink/5 dark:border-white/5 -mb-px' : 'text-ink-muted dark:text-white/55 hover:text-ink dark:hover:text-white'}`}
                  type="button"
               >
                  {tab}
               </button>
            ))
         }
      </div>

      <!-- Contenido -->
      <div class="p-5 space-y-4 bg-white dark:bg-zinc-900">
         <!-- Métricas -->
         <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {
               metrics.map((m) => (
                  <div class="rounded-xl border border-ink/5 dark:border-white/5 p-3 bg-zinc-50/50 dark:bg-zinc-950/40">
                     <p class="text-[10px] text-ink-muted dark:text-white/50 uppercase tracking-wider">{m.label}</p>
                     <p class="text-lg font-bold text-ink dark:text-white mt-1 font-mono">{m.value}</p>
                     <span class={`inline-flex items-center gap-1 mt-1 text-[10px] font-semibold ${m.color} ${m.bg} dark:bg-accent-500/15 dark:text-accent-300 px-1.5 py-0.5 rounded-full`}>
                        <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                        </svg>
                        {m.delta}
                     </span>
                  </div>
               ))
            }
         </div>

         <!-- Chart SVG -->
         <div class="rounded-xl border border-ink/5 dark:border-white/5 p-4 bg-zinc-50/30 dark:bg-zinc-950/40">
            <div class="flex items-center justify-between mb-3">
               <div>
                  <p class="text-xs text-ink-muted dark:text-white/55">Ingresos últimos 12 meses</p>
                  <p class="text-base font-bold text-ink dark:text-white font-mono">$316,420</p>
               </div>
               <div class="flex items-center gap-2 text-[10px] text-ink-muted dark:text-white/55">
                  <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-accent-500"></span>2026</span>
                  <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-ink/20 dark:bg-white/25"></span>2025</span>
               </div>
            </div>
            <svg viewBox="0 0 360 110" class="w-full h-24" preserveAspectRatio="none">
               <defs>
                  <linearGradient id="areaGrad" x1="0" x2="0" y1="0" y2="1">
                     <stop offset="0%" stop-color="#10B981" stop-opacity="0.35" />
                     <stop offset="100%" stop-color="#10B981" stop-opacity="0" />
                  </linearGradient>
               </defs>
               <!-- Grid lines -->
               <g stroke="#E4E4E7" stroke-width="1" stroke-dasharray="2 3">
                  <line x1="0" y1="20" x2="360" y2="20" />
                  <line x1="0" y1="55" x2="360" y2="55" />
                  <line x1="0" y1="90" x2="360" y2="90" />
               </g>
               <!-- 2025 line -->
               <polyline
                  points="0,75 30,72 60,68 90,72 120,65 150,70 180,62 210,58 240,55 270,52 300,50 330,48 360,45"
                  fill="none"
                  stroke="#A1A1AA"
                  stroke-width="1.5"
                  stroke-dasharray="3 3"
               />
               <!-- 2026 area + line -->
               <polyline
                  points="0,80 30,68 60,55 90,58 120,42 150,48 180,35 210,30 240,22 270,18 300,14 330,16 360,10 360,110 0,110"
                  fill="url(#areaGrad)"
               />
               <polyline
                  points="0,80 30,68 60,55 90,58 120,42 150,48 180,35 210,30 240,22 270,18 300,14 330,16 360,10"
                  fill="none"
                  stroke="#10B981"
                  stroke-width="2.5"
                  stroke-linejoin="round"
                  stroke-linecap="round"
               />
               <!-- Highlight point -->
               <circle cx="360" cy="10" r="3.5" fill="#10B981" />
               <circle cx="360" cy="10" r="6" fill="#10B981" fill-opacity="0.2" />
            </svg>
         </div>

         <!-- Activity rows -->
         <div class="space-y-2">
            {
               [
                  { name: 'Pedido #4821', tag: 'completado', delta: '+$240' },
                  { name: 'Cliente nuevo: Acme S.A.', tag: 'nuevo', delta: 'CRM' },
                  { name: 'Renovación contrato', tag: 'recurrente', delta: '+$1.2K' },
               ].map((row) => (
                  <div class="flex items-center justify-between text-xs p-2.5 rounded-lg bg-zinc-50/80 dark:bg-zinc-950/50 border border-ink/5 dark:border-white/5">
                     <div class="flex items-center gap-2 min-w-0">
                        <span class="w-7 h-7 rounded-md bg-white dark:bg-zinc-900 border border-ink/5 dark:border-white/10 flex items-center justify-center">
                           <span class="w-1.5 h-1.5 rounded-full bg-accent-500" />
                        </span>
                        <span class="text-ink dark:text-white truncate font-medium">{row.name}</span>
                     </div>
                     <div class="flex items-center gap-2 flex-shrink-0">
                        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-zinc-100 dark:bg-white/10 text-ink-muted dark:text-white/60">{row.tag}</span>
                        <span class="text-accent-600 dark:text-accent-400 font-mono font-semibold">{row.delta}</span>
                     </div>
                  </div>
               ))
            }
         </div>
      </div>
   </div>
</div>

<style>
   .scrollbar-hide::-webkit-scrollbar {
      display: none;
   }
   .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
   }
</style>
