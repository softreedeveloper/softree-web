---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { technologies } from '@/data/technologies.js';

// Duplicamos la lista para el loop infinito sin saltos.
const items = [...technologies, ...technologies];
---

<section class="py-20 md:py-28 bg-white dark:bg-zinc-950 overflow-hidden transition-colors duration-300">
   <div class="max-w-7xl mx-auto px-5 sm:px-6 md:px-10 mb-12 md:mb-16">
      <SectionHeading
         eyebrow="Stack"
         title="Tecnologías con las que construimos"
         subtitle="Herramientas modernas y probadas en producción para entregar software escalable."
         align="center"
      />
   </div>

   <!-- Carrusel infinito con fundido en los bordes -->
   <div class="relative marquee-pause">
      <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-24 z-10 bg-gradient-to-r from-white dark:from-zinc-950 to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-24 z-10 bg-gradient-to-l from-white dark:from-zinc-950 to-transparent"></div>

      <div class="marquee-track animate-marquee gap-4 sm:gap-5 py-2">
         {
            items.map((tech) => (
               <div
                  class="group flex-shrink-0 flex items-center gap-3 rounded-2xl border border-ink/10 dark:border-white/10 bg-white dark:bg-zinc-900 px-5 py-4 hover:border-accent-500/40 transition-colors"
                  aria-hidden={items.indexOf(tech) >= technologies.length ? 'true' : undefined}
               >
                  <img
                     src={`https://cdn.simpleicons.org/${tech.slug}`}
                     alt={tech.name}
                     loading="lazy"
                     width="28"
                     height="28"
                     class="w-7 h-7 shrink-0 grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300 dark:invert dark:group-hover:invert-0"
                  />
                  <span class="text-sm font-medium text-ink-muted dark:text-white/60 group-hover:text-ink dark:group-hover:text-white whitespace-nowrap transition-colors">
                     {tech.name}
                  </span>
               </div>
            ))
         }
      </div>
   </div>
</section>
