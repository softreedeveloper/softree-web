---
const services = [
   {
      title: 'Limpieza Residencial',
      desc: 'Dejamos tu hogar impecable, cuidando cada rincón con productos de alta calidad.',
      img: '/img/limpieza-residencial.png?w=600&q=80',
      tag: 'Hogares',
   },
   {
      title: 'Limpieza Comercial',
      desc: 'Espacios comerciales limpios y ordenados que transmiten confianza a tus clientes.',
      img: '/img/limpieza-comercial.png?w=600&q=80',
      tag: 'Negocios',
   },
   {
      title: 'Limpieza de Oficinas',
      desc: 'Ambientes de trabajo higiénicos que impulsan la productividad de tu equipo.',
      img: '/img/limpieza-oficinas.png?w=600&q=80',
      tag: 'Corporativo',
   },
   {
      title: 'Limpieza Post-Obra',
      desc: 'Retiro de escombros, polvo y residuos tras remodelaciones o construcciones.',
      img: '/img/limpieza-especializada.png?w=600&q=80',
      tag: 'Especializada',
   },
];
---

<section
   id="servicios"
   class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 py-24 px-4 md:px-12 overflow-hidden"
>
   <!-- Efectos de difuminación -->
   <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-20 -left-32 w-80 h-80 bg-brand-400 rounded-full blur-3xl opacity-10"></div>
      <div class="absolute bottom-40 -right-32 w-96 h-96 bg-brand-500 rounded-full blur-3xl opacity-10"></div>
   </div>
   <div class="relative z-10 max-w-7xl mx-auto">
      <div class="text-center mb-14" data-aos="fade-up">
         <span class="text-brand-500 text-sm font-semibold tracking-widest uppercase">Lo que hacemos</span>
         <h2 class="mt-3 text-3xl md:text-5xl font-extrabold text-dark leading-tight">
            Donde el orden renace,<br />
            <em class="not-italic text-brand-500">y la limpieza inspira.</em>
         </h2>
         <p class="mt-4 text-gray-500 max-w-xl mx-auto">
            Cada espacio merece un cuidado especial. Adaptamos nuestros servicios a tus necesidades.
         </p>
      </div>

      <!-- Grid de servicios -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
         {
            services.map((s, i) => (
               <div
                  class="group relative rounded-3xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-2 cursor-pointer bg-white"
                  data-aos="fade-up"
                  data-aos-delay={i * 100}
               >
                  <div class="aspect-[3/4] relative overflow-hidden">
                     <img
                        src={s.img}
                        alt={s.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                     />
                     <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-dark/10 to-transparent" />
                     <span class="absolute top-3 left-3 bg-brand-500 text-white text-xs font-semibold px-3 py-1 rounded-full">
                        {s.tag}
                     </span>
                  </div>
                  <div class="p-5">
                     <h3 class="font-bold text-dark text-lg mb-1">{s.title}</h3>
                     <p class="text-gray-500 text-sm leading-relaxed">{s.desc}</p>
                  </div>
               </div>
            ))
         }
      </div>
   </div>
</section>
