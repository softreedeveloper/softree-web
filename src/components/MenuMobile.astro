---
import { siteConfigData } from '@/utils/site-config.jsx';
---

<div class="md:hidden">
   <!-- Botón hamburguesa -->
   <button
      id="menuButton"
      class="relative flex flex-col justify-center items-center w-9 h-9 rounded-xl focus:outline-none group"
      aria-label="Abrir menú"
   >
      <span id="bar1" class="block w-5 h-0.5 bg-brand-400 rounded-full transition-all duration-300"></span>
      <span id="bar2" class="block w-5 h-0.5 bg-brand-400 rounded-full mt-1.5 transition-all duration-300"></span>
      <span
         id="bar3"
         class="block w-3 h-0.5 bg-brand-400 rounded-full mt-1.5 transition-all duration-300 group-hover:w-5"></span>
   </button>

   <!-- Overlay de fondo -->
   <div
      id="menuOverlay"
      class="fixed inset-0 bg-brand-950/60 backdrop-blur-sm z-[998] opacity-0 pointer-events-none transition-opacity duration-300"
   >
   </div>

   <!-- Panel lateral -->
   <nav
      id="menuNav"
      class="fixed top-0 right-0 h-screen w-72 bg-white z-[999] shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out"
   >
      <!-- Header del panel -->
      <div class="flex items-center justify-between px-6 py-3 border-b border-gray-100">
         <img src={siteConfigData.assets.logoshort} alt="Softree" class="h-8 w-auto" />
         <button
            id="closeButton"
            class="w-8 h-8 rounded-lg hover:bg-brand-200 flex items-center justify-center transition-colors"
            aria-label="Cerrar menú"
         >
            <svg
               class="w-6 h-6 text-brand-300"
               fill="none"
               viewBox="0 0 24 24"
               stroke="currentColor"
               stroke-width="2.5"
            >
               <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
         </button>
      </div>

      <!-- Links de navegación -->
      <div class="flex-1 px-4 py-3 overflow-y-auto">
         <ul class="space-y-0.5">
            {
               [
                  {
                     href: '/',
                     label: 'Inicio',
                     icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
                     iconBg: 'bg-brand-100',
                     iconColor: 'text-brand-600',
                     dot: 'bg-brand-500',
                  },
                  {
                     href: '/#nosotros',
                     label: 'Nosotros',
                     icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
                     iconBg: 'bg-brand-100',
                     iconColor: 'text-brand-600',
                     dot: 'bg-brand-500',
                  },
                  {
                     href: '/#servicios',
                     label: 'Servicios',
                     icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
                     iconBg: 'bg-brand-100',
                     iconColor: 'text-brand-600',
                     dot: 'bg-brand-500',
                  },
                  {
                     href: '/#contacto',
                     label: 'Contacto',
                     icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
                     iconBg: 'bg-brand-100',
                     iconColor: 'text-brand-600',
                     dot: 'bg-brand-500',
                  },
               ].map((link) => (
                  <li>
                     <a
                        href={link.href}
                        class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-700 hover:text-gray-900 hover:bg-gray-50 font-medium text-sm transition-all duration-200 group"
                     >
                        <span
                           class={`w-9 h-9 rounded-xl ${link.iconBg} flex items-center justify-center flex-shrink-0 shadow-sm group-hover:scale-110 transition-transform duration-200`}
                        >
                           <svg
                              class={`w-4 h-4 ${link.iconColor}`}
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              stroke-width="1.8"
                           >
                              <path stroke-linecap="round" stroke-linejoin="round" d={link.icon} />
                           </svg>
                        </span>
                        <span class="flex-1">{link.label}</span>
                        <span
                           class={`w-1.5 h-1.5 rounded-full ${link.dot} opacity-0 group-hover:opacity-100 transition-opacity`}
                        />
                     </a>
                  </li>
               ))
            }
         </ul>
      </div>

      <!-- CTA inferior -->
      <div
         class="px-4 pb-4 pt-3 border-t border-gray-100 space-y-2 mb-16"
         style="padding-bottom: max(1rem, env(safe-area-inset-bottom))"
      >
         <a
            href={`https://wa.me/${siteConfigData.contacto.WHATSAPP.replace(/\D/g, '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold px-5 py-2.5 rounded-xl transition-colors text-sm w-full"
         >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
               <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
               ></path>
            </svg>
            Cotiza por WhatsApp
         </a>
         <a
            href={`tel:${siteConfigData.contacto.TELEFONO}`}
            class="nav-link flex items-center justify-center gap-2 border border-gray-200 text-gray-600 hover:border-brand-300 hover:text-brand-700 font-medium px-5 py-2.5 rounded-xl transition-colors text-sm w-full"
         >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
               <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
               ></path>
            </svg>
            Llamar ahora
         </a>
      </div>
   </nav>
</div>

<script>
   const menuButton = document.getElementById('menuButton');
   const closeButton = document.getElementById('closeButton');
   const menuNav = document.getElementById('menuNav');
   const overlay = document.getElementById('menuOverlay');
   const bar1 = document.getElementById('bar1');
   const bar2 = document.getElementById('bar2');
   const bar3 = document.getElementById('bar3');

   function openMenu() {
      menuNav.classList.remove('translate-x-full');
      menuNav.classList.add('translate-x-0');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100');
      bar1.classList.add('rotate-45', 'translate-y-2');
      bar2.classList.add('opacity-0');
      bar3.classList.add('-rotate-45', '-translate-y-2', '!w-5');
      document.body.style.overflow = 'hidden';
   }

   function closeMenu() {
      menuNav.classList.add('translate-x-full');
      menuNav.classList.remove('translate-x-0');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100');
      bar1.classList.remove('rotate-45', 'translate-y-2');
      bar2.classList.remove('opacity-0');
      bar3.classList.remove('-rotate-45', '-translate-y-2', '!w-5');
      document.body.style.overflow = '';
   }

   menuButton.addEventListener('click', openMenu);
   closeButton.addEventListener('click', closeMenu);
   overlay.addEventListener('click', closeMenu);

   document.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
   });
</script>
