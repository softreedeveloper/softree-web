---
import MenuMobile from '@components/MenuMobile.astro';
import BracesLogo from '@components/ui/BracesLogo.astro';
import ThemeToggle from '@components/ui/ThemeToggle.astro';
import WhatsAppButton from '@components/tracking/WhatsAppButton.astro';

// Las landings de servicio cuelgan de un desplegable: cuatro enlaces más en la
// barra no caben en lg sin partir la línea.
const serviceLinks = [
   { label: 'Desarrollo web', href: '/desarrollo-web' },
   { label: 'Aplicaciones móviles', href: '/apps-moviles' },
   { label: 'Automatización', href: '/automatizacion' },
   { label: 'Inteligencia artificial', href: '/inteligencia-artificial' },
];

// «Todos los servicios» lleva al catálogo completo de la home (#servicios), que
// incluye también los servicios sin landing propia.
const allServicesLink = { label: 'Todos los servicios', href: '/#servicios' };

const navLinks = [
   { label: 'Inicio', href: '/' },
   { label: 'Servicios', children: serviceLinks },
   { label: 'Quiénes somos', href: '/#nosotros' },
   { label: 'Contacto', href: '/contacto' },
];

// Marca con «pill» el enlace de la página actual (y «Servicios» en sus landings).
// En build con format 'file' el pathname lleva .html; la comparación es contra el slug público.
const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (link) =>
   link.children ? link.children.some((child) => child.href === currentPath) : link.href === currentPath;
const linkBase = 'rounded-lg px-3.5 py-1.5 text-[13px] font-medium transition-colors';
const linkState = (link) =>
   isActive(link)
      ? 'bg-ink/[0.06] dark:bg-white/10 text-ink dark:text-white'
      : 'text-ink/60 dark:text-white/60 hover:text-ink dark:hover:text-white';
---

<header
   class="sticky top-0 z-50 w-full bg-white/90 dark:bg-zinc-950/85 backdrop-blur-xl border-b border-ink/5 dark:border-white/10 transition-colors duration-300"
>
   {
      /* Tres columnas: logo a la izquierda, navegación centrada en la página y
       acciones a la derecha. Las columnas laterales 1fr mantienen el centro real. */
   }
   <div
      class="max-w-7xl mx-auto px-5 sm:px-6 md:px-10 h-14 flex lg:grid lg:grid-cols-[1fr_auto_1fr] justify-between items-center"
   >
      <div class="flex items-center justify-self-start">
         <BracesLogo size="md" priority />
      </div>

      <nav class="hidden lg:flex gap-px items-center">
         {
            navLinks.map((link) =>
               link.children ? (
                  <div class="relative group">
                     <button
                        type="button"
                        class={`inline-flex items-center gap-1 ${linkBase} ${linkState(link)}`}
                        aria-haspopup="true"
                        aria-expanded="false"
                     >
                        {link.label}
                        <svg
                           class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
                           fill="none"
                           viewBox="0 0 24 24"
                           stroke="currentColor"
                           stroke-width="2"
                           aria-hidden="true"
                        >
                           <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                     </button>
                     {/* Se abre con hover o con foco de teclado; el padding superior
                      invisible evita que se cierre al cruzar el hueco. */}
                     <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-200">
                        <ul class="w-60 rounded-2xl border border-ink/10 dark:border-white/10 bg-white dark:bg-zinc-900 p-2 shadow-xl shadow-ink/10">
                           {link.children.map((child) => (
                              <li>
                                 <a
                                    href={child.href}
                                    class="flex items-center justify-between gap-3 rounded-xl px-3.5 py-2.5 text-sm text-ink/80 dark:text-white/75 hover:text-ink dark:hover:text-white hover:bg-ink/5 dark:hover:bg-white/10 transition-colors group/item"
                                 >
                                    {child.label}
                                    <svg
                                       class="w-3.5 h-3.5 text-accent-500 opacity-0 -translate-x-1 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition-all"
                                       fill="none"
                                       viewBox="0 0 24 24"
                                       stroke="currentColor"
                                       stroke-width="2"
                                       aria-hidden="true"
                                    >
                                       <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M14 5l7 7m0 0l-7 7m7-7H3"
                                       />
                                    </svg>
                                 </a>
                              </li>
                           ))}
                           <li class="mt-1 border-t border-ink/10 dark:border-white/10 pt-1">
                              <a
                                 href={allServicesLink.href}
                                 class="flex items-center justify-between gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium text-accent-600 dark:text-accent-400 hover:bg-ink/5 dark:hover:bg-white/10 transition-colors"
                              >
                                 {allServicesLink.label}
                                 <span aria-hidden="true">→</span>
                              </a>
                           </li>
                        </ul>
                     </div>
                  </div>
               ) : (
                  <a
                     href={link.href}
                     class={`${linkBase} ${linkState(link)}`}
                     aria-current={isActive(link) ? 'page' : undefined}
                  >
                     {link.label}
                  </a>
               ),
            )
         }
      </nav>

      <div class="hidden lg:flex justify-self-end items-center gap-1.5">
         <ThemeToggle class="!w-8 !h-8 !rounded-[7px]" />
         <WhatsAppButton
            id="whatsapp-global-header"
            label="Cotizar por WhatsApp"
            message="Hola Softree, me gustaría cotizar un proyecto."
            pageType="global"
            sectionName="header"
            placement="header"
            class="inline-flex items-center gap-1.5 rounded-[10px] bg-ink dark:bg-accent-500 text-white px-[18px] py-2 text-[13px] font-semibold shadow-sm hover:bg-zinc-800 dark:hover:bg-accent-600 transition-all duration-300 hover:-translate-y-0.5"
         >
            Cotizar
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
               <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
         </WhatsAppButton>
      </div>

      <div class="lg:hidden flex items-center gap-2">
         <ThemeToggle class="!w-8 !h-8 !rounded-[7px]" />
         <MenuMobile />
      </div>
   </div>
</header>
