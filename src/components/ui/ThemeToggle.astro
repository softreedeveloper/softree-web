---
interface Props {
   class?: string;
   variant?: 'icon' | 'pill';
}

const { class: extraClass = '', variant = 'icon' } = Astro.props;
---

{
   variant === 'icon' ? (
      <button
         type="button"
         data-theme-toggle
         aria-label="Cambiar tema"
         class={`relative inline-flex items-center justify-center w-9 h-9 rounded-full border border-ink/10 dark:border-white/15 hover:border-ink/30 dark:hover:border-white/30 text-ink dark:text-white hover:bg-ink/5 dark:hover:bg-white/10 transition-all duration-300 ${extraClass}`}
      >
         <!-- Sol (visible en light) -->
         <svg
            class="w-4 h-4 dark:hidden transition-transform duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
         >
            <path
               stroke-linecap="round"
               stroke-linejoin="round"
               d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            />
         </svg>
         <!-- Luna (visible en dark) -->
         <svg
            class="w-4 h-4 hidden dark:block transition-transform duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
         >
            <path
               stroke-linecap="round"
               stroke-linejoin="round"
               d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            />
         </svg>
      </button>
   ) : (
      <button
         type="button"
         data-theme-toggle
         aria-label="Cambiar tema"
         class={`inline-flex items-center justify-between gap-3 w-full px-4 py-3 rounded-xl border border-ink/10 dark:border-white/10 text-ink dark:text-white hover:bg-ink/5 dark:hover:bg-white/10 transition-colors text-sm font-medium ${extraClass}`}
      >
         <span class="flex items-center gap-2.5">
            <svg
               class="w-4 h-4 dark:hidden"
               fill="none"
               viewBox="0 0 24 24"
               stroke="currentColor"
               stroke-width="2"
            >
               <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
               />
            </svg>
            <svg
               class="w-4 h-4 hidden dark:block"
               fill="none"
               viewBox="0 0 24 24"
               stroke="currentColor"
               stroke-width="2"
            >
               <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
               />
            </svg>
            <span class="dark:hidden">Tema claro</span>
            <span class="hidden dark:inline">Tema oscuro</span>
         </span>
         <span class="text-xs font-mono text-ink-muted dark:text-white/50">cambiar</span>
      </button>
   )
}

<!-- La lógica del toggle vive en Layout.astro (script inline global) para garantizar
     que se ejecute una sola vez y enlace todos los botones en cualquier página. -->

