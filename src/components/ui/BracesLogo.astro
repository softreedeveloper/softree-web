---
interface Props {
   variant?: 'auto' | 'dark' | 'light';
   size?: 'sm' | 'md' | 'lg';
   showText?: boolean;
   class?: string;
}

const { size = 'md', class: extraClass = '' } = Astro.props;

const heights = {
   sm: 'h-6',
   md: 'h-8',
   lg: 'h-11',
};
---

<a href="/" class={`inline-flex items-center group ${extraClass}`} aria-label="Softree - Inicio">
   <img
      src="/img/Logo.png"
      alt="Softree"
      class={`${heights[size]} w-auto object-contain transition-opacity duration-300 group-hover:opacity-80 logo-dark-adapt`}
   />
</a>
