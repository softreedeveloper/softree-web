---
interface Props {
   href?: string;
   variant?: 'primary' | 'secondary' | 'accent' | 'ghost';
   size?: 'sm' | 'md' | 'lg';
   target?: string;
   rel?: string;
   arrow?: boolean;
   class?: string;
   id?: string;
}

const {
   href,
   variant = 'primary',
   size = 'md',
   target,
   rel,
   arrow = true,
   class: extraClass = '',
   id,
} = Astro.props;

const base =
   'inline-flex items-center justify-center gap-2 rounded-full font-medium transition-all duration-300 group whitespace-nowrap';

const variants = {
   primary:
      'bg-ink text-white hover:bg-zinc-800 dark:bg-white dark:text-ink dark:hover:bg-zinc-200 hover:-translate-y-0.5',
   secondary:
      'border border-ink/15 text-ink hover:bg-ink/5 hover:border-ink/30 dark:border-white/15 dark:text-white dark:hover:bg-white/10 dark:hover:border-white/30',
   accent: 'bg-accent-500 text-white hover:bg-accent-600 hover:-translate-y-0.5 shadow-sm shadow-accent-500/20',
   ghost: 'text-ink hover:bg-ink/5 dark:text-white dark:hover:bg-white/10',
};

const sizes = {
   sm: 'px-4 py-2 text-xs',
   md: 'px-6 py-3 text-sm',
   lg: 'px-7 py-3.5 text-base',
};

const cls = `${base} ${variants[variant]} ${sizes[size]} ${extraClass}`;
const Tag = href ? 'a' : 'button';
---

<Tag id={id} href={href} target={target} rel={rel} class={cls}>
   <slot />
   {
      arrow && (
         <svg
            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
         >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
         </svg>
      )
   }
</Tag>
