---
import BracesLogo from '@components/ui/BracesLogo.astro';
import { siteConfigData } from '@/utils/site-config.jsx';

const whatsappNumber = siteConfigData.contacto.WHATSAPP.replace(/\D/g, '');
---

<footer class="relative bg-ink text-white overflow-hidden">
   <!-- Strip CTA superior -->
   <div class="relative z-10 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-6 md:px-10 py-10 md:py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
         
      </div>
   </div>

   <!-- Grid principal -->
   <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 pt-14 pb-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
         <!-- Brand -->
         <div>
            <BracesLogo variant="light" size="md" />
            <p class="text-white/60 text-sm leading-relaxed mt-5 max-w-xs">
               Desarrollo de software a medida. Apps, web y soluciones que impulsan tu negocio.
            </p>
            <div class="flex gap-3 mt-6">
               <a
                  href={siteConfigData.social.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                  class="w-10 h-10 rounded-full bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 flex items-center justify-center transition-all"
               >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                     <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                  </svg>
               </a>
               <a
                  href={`https://wa.me/${whatsappNumber}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="WhatsApp"
                  class="w-10 h-10 rounded-full bg-white/5 border border-white/10 hover:bg-accent-500 hover:border-accent-500 flex items-center justify-center transition-all"
               >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                     <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                  </svg>
               </a>
            </div>
         </div>

         <!-- Navegación -->
         <div>
            <h4 class="text-white text-xs font-semibold uppercase tracking-widest mb-5">Navegación</h4>
            <ul class="space-y-3">
               {
                  [
                     { href: '/', label: 'Inicio' },
                     { href: '/#soluciones', label: 'Soluciones' },
                     { href: '/#nosotros', label: 'Quiénes somos' },
                     { href: '/#contacto', label: 'Contacto' },
                  ].map((link) => (
                     <li>
                        <a href={link.href} class="text-white/60 hover:text-white text-sm transition-colors duration-200">
                           {link.label}
                        </a>
                     </li>
                  ))
               }
            </ul>
         </div>

         <!-- Legal -->
         <div>
            <h4 class="text-white text-xs font-semibold uppercase tracking-widest mb-5">Legal</h4>
            <ul class="space-y-3">
               <li>
                  <a href="/privacypolicy" class="text-white/60 hover:text-white text-sm transition-colors">
                     Política de privacidad
                  </a>
               </li>
               <li>
                  <a href="/privacypolicy" class="text-white/60 hover:text-white text-sm transition-colors">
                     Términos y condiciones
                  </a>
               </li>
            </ul>
         </div>

         <!-- Contacto -->
         <div>
            <h4 class="text-white text-xs font-semibold uppercase tracking-widest mb-5">Contacto</h4>
            <ul class="space-y-3 text-sm">
               <li>
                  <a
                     href={`tel:${siteConfigData.contacto.TELEFONO}`}
                     class="text-white/60 hover:text-white transition-colors block"
                  >
                     {siteConfigData.contacto.TELEFONO}
                  </a>
               </li>
               <li>
                  <a
                     href={`mailto:${siteConfigData.contacto.EMAIL}`}
                     class="text-white/60 hover:text-white transition-colors block break-all"
                  >
                     {siteConfigData.contacto.EMAIL}
                  </a>
               </li>
               <li class="text-white/60">{siteConfigData.contacto.DIRECCION}</li>
            </ul>
         </div>
      </div>

      <!-- Bottom bar -->
      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
         <p class="text-white/50 text-xs">{siteConfigData.footer.COPYRIGHT}</p>
         <p class="text-white/50 text-xs">
            Hecho con <span class="text-accent-500">♥</span> por el equipo de Softree
         </p>
      </div>
   </div>
</footer>
