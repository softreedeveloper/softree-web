---
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import InitAOS from '@/utils/InitAOS.jsx';

import { siteConfig } from '@/utils/config.js';
// Fuente única de metadata: title, canonical, OG, Twitter, favicons y JSON-LD.
// No añadir etiquetas de SEO al head fuera de este componente.
import SEOHead from '@components/seo/SEOHead.astro';

// Analítica: un solo contenedor (GTM si hay PUBLIC_GTM_ID; si no, gtag con
// PUBLIC_GA4_ID; sin IDs no carga nada), pixel de Meta condicional y un único
// listener delegado de clics. Ver skills-seo/tracking-conversiones.
import TagLoader from '@components/tracking/TagLoader.astro';
import TagLoaderNoscript from '@components/tracking/TagLoaderNoscript.astro';
import MetaPixel from '@components/tracking/MetaPixel.astro';
import TrackingEvents from '@components/tracking/TrackingEvents.astro';

interface Props {
   title?: string;
   description?: string;
   image?: string;
   type?: string;
   noIndex?: boolean;
   schema?: object;
   publishedTime?: string;
   modifiedTime?: string;
}
---

<!doctype html>
<html lang={siteConfig.site.language}>
   <head>
      <!-- Charset y viewport -->
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />

      <!-- Anti-flash dark mode: corre antes del primer paint -->
      <script is:inline>
         (function () {
            try {
               var stored = localStorage.getItem('theme');
               var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
               var theme = stored || (prefersDark ? 'dark' : 'light');
               if (theme === 'dark') document.documentElement.classList.add('dark');
               document.documentElement.style.colorScheme = theme;
            } catch (e) {}
         })();
      </script>

      <SEOHead {...Astro.props} />

      <!-- Fuentes: preconnect + hoja única con display=swap -->
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
         href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
         rel="stylesheet"
      />

      <meta name="generator" content={Astro.generator} />

      <!-- Verificación de dominio de Meta -->
      <meta name="facebook-domain-verification" content="uffghfhff1th1z040abwzgjgjto9mi" />

      <TagLoader />
   </head>

   <body
      class="bg-white dark:bg-zinc-950 text-ink dark:text-zinc-100 min-h-screen flex flex-col transition-colors duration-300"
   >
      <TagLoaderNoscript />
      <MetaPixel />

      <!-- Scroll progress bar -->
      <div id="scroll-progress"></div>

      <InitAOS client:load />
      <Header />

      <main class="min-h-screen">
         <slot />
      </main>

      <Footer />

      <!-- Botón flotante volver arriba -->
      <button
         id="back-to-top"
         aria-label="Volver arriba"
         class="fixed bottom-6 right-6 z-50 w-12 h-12 bg-accent-500 hover:bg-accent-600 text-white rounded-full shadow-lg flex items-center justify-center transition-all duration-300 opacity-0 pointer-events-none translate-y-4"
      >
         <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
         </svg>
      </button>

      <script is:inline>
         (function () {
            const btn = document.getElementById('back-to-top');
            if (!btn) return;
            window.addEventListener(
               'scroll',
               function () {
                  if (window.scrollY > 400) {
                     btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
                     btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
                  } else {
                     btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
                     btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
                  }
               },
               { passive: true },
            );
            btn.addEventListener('click', function () {
               window.scrollTo({ top: 0, behavior: 'smooth' });
            });
         })();
      </script>

      <!-- Theme toggle: wire global. Inline para garantizar ejecución determinística. -->
      <script is:inline>
         (function () {
            function applyTheme(theme) {
               var root = document.documentElement;
               if (theme === 'dark') root.classList.add('dark');
               else root.classList.remove('dark');
               root.style.colorScheme = theme;
            }

            function toggleTheme() {
               var isDark = document.documentElement.classList.contains('dark');
               var next = isDark ? 'light' : 'dark';
               try {
                  localStorage.setItem('theme', next);
               } catch (e) {}
               applyTheme(next);
            }

            // Delegación de eventos: captura clicks aunque los botones se monten/desmonten
            document.addEventListener('click', function (e) {
               var target = e.target;
               if (!target || typeof target.closest !== 'function') return;
               var btn = target.closest('[data-theme-toggle]');
               if (btn) {
                  e.preventDefault();
                  toggleTheme();
               }
            });

            // Si el usuario no ha elegido manualmente, seguimos al sistema en caliente
            try {
               window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
                  try {
                     if (!localStorage.getItem('theme')) applyTheme(e.matches ? 'dark' : 'light');
                  } catch (err) {}
               });
            } catch (e) {}
         })();
      </script>

      <!-- Listener delegado de clics: whatsapp_click, phone_click, email_click, cta_click, data-ga-event -->
      <TrackingEvents />
   </body>
</html>
